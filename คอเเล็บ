local function GetInstantCoin()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = string.lower(obj.Name)
            if name == "coin" or name == "cd" or obj.Parent.Name == "CoinContainer" or obj:FindFirstChild("Coin") then
                return obj
            end
        end
    end
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj.Name == "CoinVisual" or obj.Name == "Coin" or (obj:IsA("Model") and obj:FindFirstChild("Coin")) then
            if obj:IsA("Model") then
                return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            else
                return obj
            end
        end
    end
    return nil
end

RunService.RenderStepped:Connect(function()
    if autoFarmCoinsEnabled then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local coinPart = GetInstantCoin()
            if coinPart then
                char.HumanoidRootPart.CFrame = coinPart.CFrame
            end
        end
    end
end)

