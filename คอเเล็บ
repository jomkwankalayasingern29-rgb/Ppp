local function ScanTools(container)
    local foundKnife, foundGun = false, false
    if container then
        for _, item in pairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local name = string.lower(item.Name)
                if string.find(name, "knife") or string.find(name, "dagger") or string.find(name, "blade") or item:FindFirstChild("Knife") then
                    foundKnife = true
                elseif string.find(name, "gun") or string.find(name, "pistol") or string.find(name, "revolver") or item:FindFirstChild("Gun") then
                    foundGun = true
                end
            end
        end
    end
    return foundKnife, foundGun
end

RunService.RenderStepped:Connect(function()
    if espEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local character = player.Character
                local charKnife, charGun = ScanTools(character)
                local packKnife, packGun = ScanTools(player:FindFirstChild("Backpack"))

                local color = Color3.fromRGB(80, 200, 100)
                if charKnife or packKnife then
                    color = Color3.fromRGB(220, 80, 80)
                elseif charGun or packGun then
                    color = Color3.fromRGB(80, 150, 220)
                end

                local highlight = character:FindFirstChild("ESPHighlight")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "ESPHighlight"
                    highlight.Parent = character
                end
                highlight.FillColor = color
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.5
                highlight.OutlineTransparency = 0.2
            end
        end
    end

    if gunEspEnabled then
        for _, obj in pairs(Workspace:GetDescendants()) do
            local isDroppedGun = false
            if obj:IsA("Tool") or obj:IsA("Model") then
                local n = string.lower(obj.Name)
                if n:find("gun") or n:find("pistol") or n:find("revolver") or n:find("dropped") then
                    local ancestor = obj.Parent
                    local isInPlayer = false
                    while ancestor and ancestor ~= game do
                        if ancestor:IsA("Model") and Players:GetPlayerFromCharacter(ancestor) then
                            isInPlayer = true
                            break
                        elseif ancestor:IsA("Backpack") then
                            isInPlayer = true
                            break
                        end
                        ancestor = ancestor.Parent
                    end
                    if not isInPlayer then isDroppedGun = true end
                end
            end

            if isDroppedGun then
                local targetPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")) or obj:IsA("Tool") and (obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart"))
                if targetPart and not targetPart:FindFirstChild("GunDropHighlight") then
                    local gunHighlight = Instance.new("Highlight")
                    gunHighlight.Name = "GunDropHighlight"
                    gunHighlight.FillColor = Color3.fromRGB(255, 220, 0)
                    gunHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    gunHighlight.FillTransparency = 0.3
                    gunHighlight.OutlineTransparency = 0.1
                    gunHighlight.Parent = targetPart
                end
            end
        end
    end
end)

