local isOpen = true
local function ToggleUI()
    isOpen = not isOpen
    local targetW = baseWidth * currentScale
    local targetH = baseHeight * currentScale
    if isOpen then
        MainFrame.Visible = true
        MinimizeButton.Text = "-"
        TweenService:Create(MainFrame, TweenInfo.new(0.25), {Size = UDim2.new(0, targetW, 0, targetH)}):Play()
    else
        MinimizeButton.Text = "+"
        local closeTween = TweenService:Create(MainFrame, TweenInfo.new(0.25), {Size = UDim2.new(0, targetW, 0, 32)})
        closeTween:Play()
        closeTween.Completed:Connect(function()
            if not isOpen then MainFrame.Visible = false end
        end)
    end
end

