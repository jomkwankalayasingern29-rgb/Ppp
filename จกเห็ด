-- ฟังก์ชันสร้างกล่องข้อความ (TextBox)
local function createTextBox(parent, placeholder, defaultText, callback)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.95, 0, 0, 30)
    box.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    box.BorderSizePixel = 0
    box.Font = Enum.Font.Gotham
    box.PlaceholderText = placeholder
    box.Text = defaultText
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.TextSize = 11
    box.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = box

    box.FocusLost:Connect(function()
        local num = tonumber(box.Text)
        if num then
            callback(num)
        else
            box.Text = tostring(defaultText)
        end
    end)
    return box
end

-- ฟังก์ชันเคลื่อนที่ด้วย Tween
local function MoveToTarget(targetCFrame, customSpeed)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = LocalPlayer.Character.HumanoidRootPart
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = customSpeed or 300
    if speed <= 0 then speed = 300 end
    local timeTake = distance / speed
    
    local tweenInfo = TweenInfo.new(timeTake, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    
    local completed = false
    local connection
    connection = tween.Completed:Connect(function()
        completed = true
        connection:Disconnect()
    end)
    
    while not completed and (getgenv().FastMove) do
        task.wait()
    end
    if not getgenv().FastMove then
        tween:Cancel()
    end
end

