RunService.RenderStepped:Connect(function()
    for _, textObj in pairs(espTextObjects) do
        textObj:Remove()
    end
    espTextObjects = {}

    -- ESP ตัวละคร
    if espEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local character = player.Character
                local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
                
                if head then
                    local pos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.8, 0))
                    local charKnife, charGun = ScanTools(character)
                    local packKnife, packGun = ScanTools(player:FindFirstChild("Backpack"))

                    local color = Color3.fromRGB(80, 200, 100)
                    if charKnife or packKnife then
                        color = Color3.fromRGB(220, 80, 80)
                    elseif charGun or packGun then
                        color = Color3.fromRGB(80, 150, 220)
                    end

                    local highlight = character:FindFirstChild("ESPHighlight")
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "ESPHighlight"
                        highlight.Parent = character
                    end
                    highlight.FillColor = color
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5

                    if onScreen then
                        local textObj = Drawing.new("Text")
                        textObj.Text = player.Name
                        textObj.Color = color
                        textObj.Position = Vector2.new(pos.X, pos.Y)
                        textObj.Center = true
                        textObj.Outline = true
                        textObj.Size = 14
                        textObj.Visible = true
                        table.insert(espTextObjects, textObj)
                    end
                end
            end
        end
    end

    -- ESP ปืนตกพื้น (ระบบสแกนใหม่ เจาะลึกทุกชิ้นส่วนใน Workspace)
    if gunEspEnabled then
        for _, obj in pairs(Workspace:GetDescendants()) do
            local isGun = false
            if obj:IsA("Tool") or obj:IsA("Model") then
                local n = string.lower(obj.Name)
                if n:find("gun") or n:find("pistol") or n:find("revolver") or n:find("drop") then
                    isGun = true
                end
            end

            if isGun then
                local targetPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")) or (obj:IsA("Tool") and obj:FindFirstChild("Handle"))
                
                if targetPart and not targetPart:FindFirstChild("GunDropHighlight") then
                    local gunHighlight = Instance.new("Highlight")
                    gunHighlight.Name = "GunDropHighlight"
                    gunHighlight.FillColor = Color3.fromRGB(255, 220, 0) -- สีเหลืองทอง
                    gunHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    gunHighlight.FillTransparency = 0.2
                    gunHighlight.OutlineTransparency = 0
                    gunHighlight.Parent = targetPart
                end
            end
        end
    end
end)

-- ปุ่มเปิดปิด UI หลัก
local isOpen = false
local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

local function ToggleUI()
    isOpen = not isOpen
    if isOpen then
        MainFrame.Visible = true
        MainFrame.Size = UDim2.new(0, 40, 0, 40)
        MainFrame.Position = ToggleBtn.Position
        MainFrame.BackgroundTransparency = 1
        
        local targetW = baseWidth * currentScale
        local targetH = baseHeight * currentScale
        
        TweenService:Create(MainFrame, tweenInfo, {
            Size = UDim2.new(0, targetW, 0, targetH),
            Position = UDim2.new(0.5, -targetW/2, 0.5, -targetH/2),
            BackgroundTransparency = 1 - currentAlpha
        }):Play()
    else
        local closeTween = TweenService:Create(MainFrame, tweenInfo, {
            Size = UDim2.new(0, 40, 0, 40),
            Position = ToggleBtn.Position,
            BackgroundTransparency = 1
        })
        closeTween:Play()
        closeTween.Completed:Connect(function()
            if not isOpen then MainFrame.Visible = false end
        end)
    end
end

ToggleBtn.MouseButton1Click:Connect(ToggleUI)
MinBtn.MouseButton1Click:Connect(ToggleUI)
