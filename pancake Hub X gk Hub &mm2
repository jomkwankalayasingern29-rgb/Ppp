local espTextObjects = {}

local function ScanTools(container)
    local foundKnife, foundGun = false, false
    if container then
        for _, item in pairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local name = string.lower(item.Name)
                if string.find(name, "knife") or string.find(name, "dagger") or string.find(name, "blade") or item:FindFirstChild("Knife") then
                    foundKnife = true
                elseif string.find(name, "gun") or string.find(name, "pistol") or string.find(name, "revolver") or item:FindFirstChild("Gun") then
                    foundGun = true
                end
            end
        end
    end
    return foundKnife, foundGun
end

