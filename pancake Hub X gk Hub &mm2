local espTextObjects = {}
local function ScanTools(container)
    local foundKnife, foundGun = false, false
    if container then
        for _, item in pairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local name = string.lower(item.Name)
                if name:find("knife") or name:find("dagger") or name:find("blade") or item:FindFirstChild("Knife") then
                    foundKnife = true
                elseif name:find("gun") or name:find("pistol") or name:find("revolver") or item:FindFirstChild("Gun") then
                    foundGun = true
                end
            end
        end
    end
    return foundKnife, foundGun
end

RunService.RenderStepped:Connect(function()
    for _, v in pairs(espTextObjects) do pcall(function() v:Remove() end) end
    espTextObjects = {}

    if not espEnabled then return end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local character = player.Character
            local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
            if head then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.8, 0))
                local cKnife, cGun = ScanTools(character)
                local pKnife, pGun = ScanTools(player:FindFirstChild("Backpack"))

                local color = Color3.fromRGB(80, 200, 100)
                if cKnife or pKnife then
                    color = Color3.fromRGB(220, 80, 80)
                elseif cGun or pGun then
                    color = Color3.fromRGB(80, 150, 220)
                end

                local highlight = character:FindFirstChild("ESPHighlight")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "ESPHighlight"
                    highlight.Parent = character
                end
                highlight.FillColor = color
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.5
                highlight.OutlineTransparency = 0.2

                if onScreen then
                    local textObj = Drawing.new("Text")
                    textObj.Text = player.Name
                    textObj.Color = color
                    textObj.Position = Vector2.new(pos.X, pos.Y)
                    textObj.Center = true
                    textObj.Outline = true
                    textObj.Size = 14
                    textObj.Visible = true
                    table.insert(espTextObjects, textObj)
                end
            end
        end
    end
end)

-- UI Toggle Animation & Dragging
local isOpen = false
local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

local function ToggleUI()
    isOpen = not isOpen
    if isOpen then
        MainFrame.Visible = true
        MainFrame.Size = UDim2.new(0, 40, 0, 40)
        MainFrame.Position = ToggleBtn.Position
        TweenService:Create(MainFrame, tweenInfo, {
            Size = UDim2.new(0, baseWidth * currentScale, 0, baseHeight * currentScale),
            Position = UDim2.new(0.5, -(baseWidth * currentScale)/2, 0.5, -(baseHeight * currentScale)/2),
            BackgroundTransparency = 1 - currentAlpha
        }):Play()
    else
        local closeTween = TweenService:Create(MainFrame, tweenInfo, {
            Size = UDim2.new(0, 40, 0, 40),
            Position = ToggleBtn.Position,
            BackgroundTransparency = 1
        })
        closeTween:Play()
        closeTween.Completed:Connect(function()
            if not isOpen then MainFrame.Visible = false end
        end)
    end
end

