local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- -------------------------------------------------------
-- 🔍 1. ระบบรักษาปุ่มมือถือ (ป้องกันทัชหาย)
-- -------------------------------------------------------
local containers = {CoreGui, PlayerGui}
if gethui then table.insert(containers, gethui()) end

local existingGuis = {}
for _, container in pairs(containers) do
    for _, v in pairs(container:GetChildren()) do
        existingGuis[v] = true
    end
end

-- -------------------------------------------------------
-- 📦 2. โหลด MacLib UI
-- -------------------------------------------------------
local success, MacLib = pcall(function()
    return loadstring(game:HttpGet("https://github.com/biggaboy212/Maclib/releases/latest/download/maclib.txt"))()
end)

if not success or not MacLib then
    warn("PancakeHUB: Failed to load MacLib!")
    return
end

local Window = MacLib:Window({
    Title = "PancakeHUB | MM2",
    Subtitle = "Mobile Optimized",
    Size = UDim2.fromOffset(400, 240),
    DragStyle = 1,
    Keybind = Enum.KeyCode.RightControl,
    AcrylicBlur = false,
})

-- -------------------------------------------------------
-- 🎯 3. สแกนหา UI ของ MacLib เพื่อควบคุมการปิด/เปิด
-- -------------------------------------------------------
local macGui = nil
task.spawn(function()
    task.wait(0.5)
    for _, container in pairs(containers) do
        for _, v in pairs(container:GetChildren()) do
            if not existingGuis[v] and v:IsA("ScreenGui") and v.Name ~= "TouchGui" and v.Name ~= "PancakeHUB_MobileToggle" then
                macGui = v
            end
        end
    end
end)

