-- -------------------------------------------------------
-- 🛠️ 5. ตัวแปรเปิด/ปิด สวิตช์ ESP
-- -------------------------------------------------------
local scriptRunning = true
local esp3D = false
local espTracer = false
local espGreenbox = false

-- Folder สำหรับเก็บ Highlight 3D
local highlightFolder = Instance.new("Folder", CoreGui)
highlightFolder.Name = "PancakeHUB_3DESP"

-- Storage สำหรับเก็บ Drawing Objects
local drawings = {}

-- -------------------------------------------------------
-- 🔍 6. ฟังก์ชันเช็คบทบาท MM2 (Role Checker)
-- -------------------------------------------------------
local function getPlayerRoleColor(player)
    if not player then return Color3.fromRGB(0, 255, 0) end
    
    local char = player.Character
    local backpack = player:FindFirstChild("Backpack")
    
    local hasKnife = false
    local hasGun = false
    
    if char then
        if char:FindFirstChild("Knife") or char:FindFirstChild("KnifeServer") then hasKnife = true end
        if char:FindFirstChild("Gun") or char:FindFirstChild("GunServer") then hasGun = true end
    end
    
    if backpack then
        if backpack:FindFirstChild("Knife") or backpack:FindFirstChild("KnifeServer") then hasKnife = true end
        if backpack:FindFirstChild("Gun") or backpack:FindFirstChild("GunServer") then hasGun = true end
    end
    
    if hasKnife then
        return Color3.fromRGB(255, 0, 0) -- 🔴 ฆาตกร
    elseif hasGun then
        return Color3.fromRGB(0, 150, 255) -- 🔵 นายอำเภอ
    else
        return Color3.fromRGB(0, 255, 0) -- 🟢 ประชาชนบริสุทธิ์
    end
end

-- -------------------------------------------------------
-- 🧹 7. ฟังก์ชันทำความสะอาด Drawing & Highlights
-- -------------------------------------------------------
local function clearDrawings()
    for _, d in pairs(drawings) do
        if d.Remove then d:Remove() end
    end
    drawings = {}
end

-- -------------------------------------------------------
-- 🔄 8. Main Render Loop
-- -------------------------------------------------------
RunService.RenderStepped:Connect(function()
    if not scriptRunning then return end
    
    highlightFolder:ClearAllChildren()
    clearDrawings()

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChildOfClass("Humanoid") then
            local char = plr.Character
            local root = char.HumanoidRootPart
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if hum.Health > 0 then
                local color = getPlayerRoleColor(plr)
                
                -- 1. มองทะลุ 3D (Highlight)
                if esp3D then
                    local hl = Instance.new("Highlight")
                    hl.Name = plr.Name .. "_3D"
                    hl.Adornee = char
                    hl.FillColor = color
                    hl.FillTransparency = 0.4
                    hl.OutlineColor = color
                    hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = highlightFolder
                end

                local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                
                if onScreen then
                    -- 2. Tracer
                    if espTracer then
                        local line = Drawing.new("Line")
                        line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        line.To = Vector2.new(pos.X, pos.Y)
                        line.Color = color
                        line.Thickness = 1.2
                        line.Transparency = 1
                        line.Visible = true
                        table.insert(drawings, line)
                    end

                    -- 3. Greenbox
                    if espGreenbox then
                        local head = char:FindFirstChild("Head")
                        if head then
                            local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                            local legPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
                            
                            local height = math.abs(headPos.Y - legPos.Y)
                            local width = height / 1.6

                            local box = Drawing.new("Square")
                            box.Size = Vector2.new(width, height)
                            box.Position = Vector2.new(pos.X - (width / 2), pos.Y - (height / 2))
                            box.Color = Color3.fromRGB(0, 255, 0)
                            box.Thickness = 1.2
                            box.Filled = false
                            box.Transparency = 1
                            box.Visible = true
                            table.insert(drawings, box)
                        end
                    end
                end
            end
        end
    end
end)

