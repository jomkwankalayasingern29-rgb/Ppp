​-- 🛠️ 5. ตัวแปรเปิด/ปิด สวิตช์
​local esp3D = false
local espTracer = false
local espGreenbox = false
​-- Folder สำหรับเก็บ Highlight 3D
local highlightFolder = Instance.new("Folder", CoreGui)
highlightFolder.Name = "PancakeHUB_3DESP"
​-- ตรวจสอบ Drawing Library
local hasDrawing = (typeof(Drawing) == "table" and Drawing.new ~= nil)
​-- Object Pools สำหรับลดการสร้างวัตถุซ้ำซ้อน (Performance Boost บนมือถือ)
local tracerPool = {}
local boxPool = {}
​local function getTracer(index)
if not tracerPool[index] and hasDrawing then
local line = Drawing.new("Line")
line.Thickness = 1.2
line.Transparency = 1
tracerPool[index] = line
end
return tracerPool[index]
end
​local function getBox(index)
if not boxPool[index] and hasDrawing then
local box = Drawing.new("Square")
box.Thickness = 1.2
box.Filled = false
box.Transparency = 1
boxPool[index] = box
end
return boxPool[index]
end
​local function hideAllDrawings()
for _, line in pairs(tracerPool) do line.Visible = false end
for _, box in pairs(boxPool) do box.Visible = false end
end
​-- 🔍 6. ฟังก์ชันเช็คบทบาท MM2 (Role Checker ที่เสถียรขึ้น)
​local function getPlayerRoleColor(player)
if not player then return Color3.fromRGB(0, 255, 0) end
​local char = player.Character
local backpack = player:FindFirstChild("Backpack")
​local hasKnife = false
local hasGun = false
​local function checkItem(container)
if not container then return end
for _, item in pairs(container:GetChildren()) do
if item:IsA("Tool") then
local name = item.Name:lower()
if name:find("knife") then hasKnife = true end
if name:find("gun") or name:find("revolver") then hasGun = true end
end
end
end
​if char then checkItem(char) end
if backpack then checkItem(backpack) end
​if hasKnife then
return Color3.fromRGB(255, 50, 50) -- 🔴 ฆาตกร
elseif hasGun then
return Color3.fromRGB(50, 150, 255) -- 🔵 นายอำเภอ
else
return Color3.fromRGB(50, 255, 50) -- 🟢 ประชาชนบริสุทธิ์
end
end
​-- 🔄 7. Main Render Loop (อัปเดตระบบ ESP ตลอดเวลา)
​RunService.RenderStepped:Connect(function()
highlightFolder:ClearAllChildren()
hideAllDrawings()
​if not esp3D and not espTracer and not espGreenbox then return end
​local tracerIndex = 0
local boxIndex = 0
​for _, plr in pairs(Players:GetPlayers()) do
if plr ~= LocalPlayer and plr.Character then
local char = plr.Character
local root = char:FindFirstChild("HumanoidRootPart")
local hum = char:FindFirstChildOfClass("Humanoid")
​if root and hum and hum.Health > 0 then
local color = getPlayerRoleColor(plr)
​-- 🟢 1. มองทะลุ 3D (Highlight)
if esp3D then
local hl = Instance.new("Highlight")
hl.Name = plr.Name .. "_3D"
hl.Adornee = char
hl.FillColor = color
hl.FillTransparency = 0.45
hl.OutlineColor = color
hl.OutlineTransparency = 0
hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
hl.Parent = highlightFolder
end
​if espTracer or espGreenbox then
local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
​if onScreen then
-- 📏 2. มองทะลุเป็นเส้น (Tracer)
if espTracer and hasDrawing then
tracerIndex = tracerIndex + 1
local line = getTracer(tracerIndex)
if line then
line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
line.To = Vector2.new(pos.X, pos.Y)
line.Color = color
line.Visible = true
end
end
​-- 📦 3. มองทะลุ Greenbox (Box ESP)
if espGreenbox and hasDrawing then
local head = char:FindFirstChild("Head")
if head then
local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
local legPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
​local height = math.abs(headPos.Y - legPos.Y)
local width = height / 1.6
​boxIndex = boxIndex + 1
local box = getBox(boxIndex)
if box then
box.Size = Vector2.new(width, height)
box.Position = Vector2.new(pos.X - (width / 2), pos.Y - (height / 2))
box.Color = Color3.fromRGB(50, 255, 50)
box.Visible = true
end
end
end
end
end
end
end
end
end)
