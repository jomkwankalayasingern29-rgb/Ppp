-- 🛠️ 5. ตัวแปรและฟังก์ชันระบบหลัก
-- -------------------------------------------------------
local espEnabled = false
local noclipEnabled = false
local autoShootEnabled = false
local miniShootGui = nil
local espTextObjects = {}

local function ScanTools(container)
    local foundKnife, foundGun = false, false
    if container then
        for _, item in pairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local name = string.lower(item.Name)
                if string.find(name, "knife") or string.find(name, "dagger") or string.find(name, "blade") or string.find(name, "sword") or item:FindFirstChild("Knife") then
                    foundKnife = true
                elseif string.find(name, "gun") or string.find(name, "pistol") or string.find(name, "revolver") or string.find(name, "rifle") or string.find(name, "shotgun") or item:FindFirstChild("Gun") then
                    foundGun = true
                end
            end
        end
    end
    return foundKnife, foundGun
end

local function ClearAllHighlights()
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            local highlight = player.Character:FindFirstChild("ESPHighlight")
            if highlight then highlight:Destroy() end
        end
    end
end

local function TriggerMM2Shoot()
    local myChar = LocalPlayer.Character
    if not myChar then return end

    local gunTool = myChar:FindFirstChild("Gun")
    if not gunTool then
        for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
            if item:IsA("Tool") and (string.lower(item.Name):find("gun") or item:FindFirstChild("GunScript") or item:FindFirstChild("Shoot")) then
                item.Parent = myChar
                gunTool = item
                task.wait(0.1)
                break
            end
        end
    end
    if not gunTool then gunTool = myChar:FindFirstChildWhichIsA("Tool") end
    if not gunTool then return end

    local targetHead = nil
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local charKnife, _ = ScanTools(p.Character)
            local packKnife, _ = ScanTools(p:FindFirstChild("Backpack"))
            
            if charKnife or packKnife then
                local head = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
                if head then
                    targetHead = head
                    break
                end
            end
        end
    end

    if targetHead then
        local remote = nil
        for _, desc in pairs(gunTool:GetDescendants()) do
            if desc:IsA("RemoteEvent") then
                remote = desc
                break
            end
        end
        if remote then
            remote:FireServer(targetHead.Position)
        else
            gunTool.Parent = myChar
            gunTool:Activate()
        end
    end
end

