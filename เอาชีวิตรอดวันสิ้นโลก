-- ล็อกความเร็วไม่ให้ปืนรีเซ็ต
RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        local hum = char.Humanoid
        if Config.EnableSpeed and hum.WalkSpeed ~= CurrentWalkSpeed then
            hum.WalkSpeed = CurrentWalkSpeed
        end
        if Config.EnableJump and hum.JumpPower ~= CurrentJumpPower then
            hum.UseJumpPower = true
            hum.JumpPower = CurrentJumpPower
        end
    end
end)

LocalPlayer.CharacterAdded:Connect(function(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then
        if Config.EnableSpeed then hum.WalkSpeed = CurrentWalkSpeed end
        if Config.EnableJump then hum.UseJumpPower = true; hum.JumpPower = CurrentJumpPower end
    end
end)

GiveToolBtn.MouseButton1Click:Connect(function()
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local character = LocalPlayer.Character
    if not backpack or not character then return end
    if backpack:FindFirstChild("ClickTeleportTool") or character:FindFirstChild("ClickTeleportTool") then
        showNotification("คุณมีไอเท็มนี้อยู่ในกระเป๋าแล้ว!", false)
        return
    end

    local tool = Instance.new("Tool")
    tool.Name = "ClickTeleportTool"
    tool.RequiresHandle = true
    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(1, 1, 3)
    handle.BrickColor = BrickColor.new("Bright red")
    handle.Parent = tool
    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.Wedge
    mesh.Parent = handle

    tool.Activated:Connect(function()
        local mouse = LocalPlayer:GetMouse()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))
            showNotification("วาร์ปไปยังตำแหน่งที่คลิกสำเร็จ!", true)
        end
    end)
    tool.Parent = backpack
    showNotification("รับอุปกรณ์คลิกวาร์ปสำเร็จ!", true)
end)

-- ปรับแต่งลูป ESP ไม่ให้หน่วง/แลค และกรองเฉพาะไอเท็มน้ำมัน/แบตเตอรี่/อาหารจริง ๆ
task.spawn(function()
    while task.wait(1) do -- ขยายเวลาลูปเป็น 1 วินาที เพื่อไม่ให้เครื่องกระตุก
        if not ScreenGui.Parent then break end

        -- 1. ESP สิ่งของ / เชื้อเพลิง / แบตเตอรี่ (กรองรถและฉากออก)
        if Config.EpsItem then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if not obj:IsDescendantOf(LocalPlayer.Character) then
                    local isItem = false
                    local partTarget = nil

                    if obj:IsA("ProximityPrompt") then
                        local parentModel = obj.Parent and obj.Parent.Parent
                        local promptText = string.lower(obj.ActionText)
                        local parentName = parentModel and string.lower(parentModel.Name) or ""
                        
                        -- เช็คคำสั่งเก็บของ หรือชื่อไอเท็มที่จับต้องได้
                        if string.find(promptText, "take") or string.find(promptText, "pickup") or string.find(promptText, "เก็บ") or string.find(parentName, "fuel") or string.find(parentName, "battery") or string.find(parentName, "item") then
                            if not (string.find(parentName, "car") or string.find(parentName, "vehicle") or string.find(parentName, "door")) then
                                isItem = true
                                partTarget = obj.Parent
                            end
                        end
                    elseif obj:IsA("BasePart") then
                        local nLower = string.lower(obj.Name)
                        -- ค้นหาเฉพาะชื่อชิ้นส่วนที่เป็นถังน้ำมัน แบตเตอรี่ หรือกล่องไอเท็ม
                        if (string.find(nLower, "fuel") or string.find(nLower, "gas") or string.find(nLower, "oil") or string.find(nLower, "battery") or string.find(nLower, "loot") or string.find(nLower, "ammo") or string.find(nLower, "can")) and not string.find(nLower, "car") and not string.find(nLower, "road") then
                            isItem = true
                            partTarget = obj
                        end
                    end

                    if isItem and partTarget and partTarget:IsA("BasePart") then
                        local hl = partTarget:FindFirstChild("HJ1JK_ItemESP") or Instance.new("Highlight")
                        hl.Name = "HJ1JK_ItemESP"
                        hl.FillColor = Color3.fromRGB(255, 215, 0)
                        hl.FillTransparency = 0.4
                        hl.OutlineTransparency = 0
                        hl.Parent = partTarget

                        local bb = partTarget:FindFirstChild("HJ1JK_ItemText") or Instance.new("BillboardGui")
                        bb.Name = "HJ1JK_ItemText"
                        bb.Size = UDim2.new(0, 140, 0, 40)
                        bb.StudsOffset = Vector3.new(0, 2.5, 0)
                        bb.AlwaysOnTop = true
                        bb.Parent = partTarget

                        local tx = bb:FindFirstChild("TextLabel") or Instance.new("TextLabel")
                        if not bb:FindFirstChild("TextLabel") then
                            tx.Size = UDim2.new(1, 0, 1, 0)
                            tx.BackgroundTransparency = 1
                            tx.TextColor3 = Color3.fromRGB(255, 255, 100)
                            tx.TextSize = 12
                            tx.Font = Enum.Font.GothamBold
                            tx.TextStrokeTransparency = 0.2
                            tx.Parent = bb
                        end

                        local originalName = obj:IsA("ProximityPrompt") and obj.ActionText or partTarget.Name
                        tx.Text = "📦 " .. getThaiItemName(originalName)
                    end
                end
            end
        else
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj.Name == "HJ1JK_ItemESP" or obj.Name == "HJ1JK_ItemText" then obj:Destroy() end
            end
        end

        -- 2. ESP NPC
        if Config.EpsNpc then
            for _, desc in ipairs(Workspace:GetDescendants()) do
                if desc:IsA("Model") and desc:FindFirstChild("Humanoid") and not Players:GetPlayerFromCharacter(desc) and desc ~= LocalPlayer.Character then
                    local nameLower = string.lower(desc.Name)
                    if not string.find(nameLower, "zombie") and not string.find(nameLower, "infected") and not string.find(nameLower, "undead") then
                        local ncham = desc:FindFirstChild("HJ1JK_NpcESP") or Instance.new("Highlight")
                        ncham.Name = "HJ1JK_NpcESP"
                        ncham.FillColor = Color3.fromRGB(0, 200, 255)
                        ncham.FillTransparency = 0.5
                        ncham.Parent = desc
                    end
                end
            end
        else
            for _, desc in ipairs(Workspace:GetDescendants()) do
                if desc:IsA("Model") and desc:FindFirstChild("HJ1JK_NpcESP") then desc.HJ1JK_NpcESP:Destroy() end
            end
        end

        -- 3. ESP ซอมบี้
        if Config.EpsZombie then
            for _, desc in ipairs(Workspace:GetDescendants()) do
                if desc:IsA("Model") and desc:FindFirstChild("Humanoid") then
                    local nameLower = string.lower(desc.Name)
                    if string.find(nameLower, "zombie") or string.find(nameLower, "infected") or string.find(nameLower, "undead") or string.find(nameLower, "mutant") then
                        local zcham = desc:FindFirstChild("HJ1JK_ZombieESP") or Instance.new("Highlight")
                        zcham.Name = "HJ1JK_ZombieESP"
                        zcham.FillColor = Color3.fromRGB(255, 50, 50)
                        zcham.FillTransparency = 0.4
                        zcham.Parent = desc
                    end
                end
            end
        else
            for _, desc in ipairs(Workspace:GetDescendants()) do
                if desc:IsA("Model") and desc:FindFirstChild("HJ1JK_ZombieESP") then desc.HJ1JK_ZombieESP:Destroy() end
            end
        end

        -- 4. ระบบเก็บของทันที (0 วินาที)
        if Config.InstantPickup then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("ProximityPrompt") then
                    if obj.HoldDuration > 0 then
                        obj.HoldDuration = 0
                    end
                end
            end
        end
    end
end)

local walkSpeedDragging, jumpPowerDragging = false, false

WalkSpeedBtn.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then walkSpeedDragging = true end end)
JumpPowerBtn.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then jumpPowerDragging = true end end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
        walkSpeedDragging = false; jumpPowerDragging = false
    end 
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if walkSpeedDragging then
            local percentage = math.clamp((input.Position.X - WalkSpeedBack.AbsolutePosition.X) / WalkSpeedBack.AbsoluteSize.X, 0, 1)
            WalkSpeedBtn.Position = UDim2.new(percentage, -7, 0, -4.5)
            CurrentWalkSpeed = math.floor(1 + (percentage * 999))
            WalkSpeedLabel.Text = "ความเร็ว (WalkSpeed): " .. CurrentWalkSpeed
        end
        if jumpPowerDragging then
            local percentage = math.clamp((input.Position.X - JumpPowerBack.AbsolutePosition.X) / JumpPowerBack.AbsoluteSize.X, 0, 1)
            JumpPowerBtn.Position = UDim2.new(percentage, -7, 0, -4.5)
            CurrentJumpPower = math.floor(1 + (percentage * 999))
            JumpPowerLabel.Text = "กระโดดสูง (JumpPower): " .. CurrentJumpPower
        end
    end
end)

