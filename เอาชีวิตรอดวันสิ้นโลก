    barFill.Parent = barBack
    local barFillCorner = Instance.new("UICorner"); barFillCorner.CornerRadius = UDim.new(1, 0); barFillCorner.Parent = barFill

    task.spawn(function()
        local tweenIn = TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)})
