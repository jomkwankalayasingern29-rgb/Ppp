local function switchTab(activeTab, activeBtn)
    local tabs = {EpsTab, ToolTab, MovementTab}
    local btns = {EpsCategoryBtn, ToolCategoryBtn, MovementCategoryBtn}
    
    for _, tab in ipairs(tabs) do tab.Visible = (tab == activeTab) end
    for _, btn in ipairs(btns) do
        btn.BackgroundColor3 = (btn == activeBtn) and Color3.fromRGB(40, 40, 40) or Color3.fromRGB(25, 25, 25)
        btn.TextColor3 = (btn == activeBtn) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)
    end
end

