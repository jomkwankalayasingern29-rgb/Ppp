local function showNotification(text, isEnabled)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 50)
    card.Position = UDim2.new(1, 40, 0, 0)
    card.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    card.BorderSizePixel = 0
    card.Parent = NotifContainer

    local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 6); corner.Parent = card
    local stroke = Instance.new("UIStroke")
    stroke.Color = isEnabled and Color3.fromRGB(50, 255, 100) or Color3.fromRGB(255, 50, 50)
    stroke.Thickness = 1.2
    stroke.Parent = card

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -16, 0, 30)
    lbl.Position = UDim2.new(0, 8, 0, 4)
    lbl.BackgroundTransparency = 1
