local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = MainFrame.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
    end
end)
TopBar.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

local isMinimized = false
local function minimizeUI()
    if isMinimized or ConfirmOverlay.Visible then return end
    isMinimized = true
    local minimizeTween = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(0, 420, 0, 0), BackgroundTransparency = 1})
    minimizeTween:Play()
    minimizeTween.Completed:Connect(function()
        if isMinimized then
            MainFrame.Visible = false; D_Icon.Visible = true; D_Icon.Size = UDim2.new(0, 0, 0, 0)
            TweenService:Create(D_Icon, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 40, 0, 40)}):Play()
        end
    end)
end

local function maximizeUI()
    if not isMinimized then return end
    isMinimized = false
    D_Icon.Visible = false; MainFrame.Visible = true; MainFrame.BackgroundTransparency = 0
    TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(0, 420, 0, 300)}):Play()
end

MinimizeButton.MouseButton1Click:Connect(minimizeUI)
D_Icon.MouseButton1Click:Connect(maximizeUI)
CloseButton.MouseButton1Click:Connect(function() if not isMinimized then ConfirmOverlay.Visible = true end end)
NoButton.MouseButton1Click:Connect(function() ConfirmOverlay.Visible = false end)
YesButton.MouseButton1Click:Connect(function()
    local closeTween = TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(0, 420, 0, 0), BackgroundTransparency = 1})
    closeTween:Play()
    closeTween.Completed:Wait()
    ScreenGui:Destroy(); NotifGui:Destroy(); D_Icon:Destroy()
end)
