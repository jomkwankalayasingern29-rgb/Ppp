local isFlinging = false
local originalPosition = nil
local connection = nil

-- ค้นหาผู้เล่นจากชื่อที่พิมพ์
local function getTarget(nameInput)
    if nameInput == "" then return nil end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if string.lower(player.Name):sub(1, #nameInput) == string.lower(nameInput) or 
               string.lower(player.DisplayName):sub(1, #nameInput) == string.lower(nameInput) then
                return player
            end
        end
    end
    return nil
end

-- ปุ่มกดเริ่ม/หยุด Fling
FlingButton.MouseButton1Click:Connect(function()
    isFlinging = not isFlinging
    
    if isFlinging then
        local targetPlayer = getTarget(TextBox.Text)
        if not targetPlayer or not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            isFlinging = false
            FlingButton.Text = "ไม่พบผู้เล่น!"
            task.wait(1)
            FlingButton.Text = "Status: OFF"
            return
        end
        
        -- บันทึกตำแหน่งเดิมก่อนวาร์ปไป
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            originalPosition = char.HumanoidRootPart.CFrame
        else
            isFlinging = false
            return
        end
        
        FlingButton.Text = "Status: ON"
        FlingButton.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        
        -- เริ่มทำงานลูปหมุนตัวและวาร์ปจุ่ม
        connection = RunService.Stepped:Connect(function()
            if not _G.DeltaFlingRunning then 
                if connection then connection:Disconnect() end
                return 
            end
            
            local myChar = LocalPlayer.Character
            local tChar = targetPlayer.Character
            
            if myChar and tChar and myChar:FindFirstChild("HumanoidRootPart") and tChar:FindFirstChild("HumanoidRootPart") then
                local myRoot = myChar.HumanoidRootPart
                local tRoot = tChar.HumanoidRootPart
                
                -- ปิดการชนกับเพื่อนร่วมทีมชั่วคราวเพื่อให้แทรกตัวง่ายขึ้น (ถ้าทำได้) หรือใช้วิธีอัดความเร็วรอบหมุน
                myRoot.Velocity = Vector3.new(30000, 30000, 30000)
                myRoot.RotVelocity = Vector3.new(50000, 50000, 50000)
                myRoot.CFrame = tRoot.CFrame
            end
        end)
    else
        -- ปิดการทำงาน และวาร์ปกลับตำแหน่งเดิม
        if connection then
            connection:Disconnect()
            connection = nil
        end
        
        FlingButton.Text = "Status: OFF"
        FlingButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        
        task.wait(0.1)
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") and originalPosition then
            myChar.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
            myChar.HumanoidRootPart.RotVelocity = Vector3.new(0, 0, 0)
            myChar.HumanoidRootPart.CFrame = originalPosition
        end
    end
end)

-- เคลียร์ GUI เมื่อตัวละครรีเซ็ตหรือออกเกม
LocalPlayer.CharacterAdded:Connect(function()
    if isFlinging then
        isFlinging = false
        if connection then connection:Disconnect() end
        FlingButton.Text = "Status: OFF"
        FlingButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)
