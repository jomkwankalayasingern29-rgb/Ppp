-- ฟังก์ชันรันโค้ด
local function runCode(times)
	local codeText = textBox.Text
	if codeText == "" then return end
	
	local func, err = loadstring(codeText)
	if func then
		pcall(function()
			for i = 1, times do
				func()
			end
		end)
	else
		warn("Code Error: " .. tostring(err))
	end
end

-- สร้างปุ่มกด (จัดระยะปุ่มใหม่ให้ไม่ทับกัน)
local function createButton(name, text, posX, sizeX, color, callback)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Size = UDim2.new(sizeX, -3, 0, 26)
	btn.Position = UDim2.new(posX, 0, 0, 102)
	btn.BackgroundColor3 = color
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 12
	btn.Font = Enum.Font.SourceSansBold
	btn.Parent = frame
	
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 4)
	c.Parent = btn
	
	btn.MouseButton1Click:Connect(callback)
end

-- จัดเรียงปุ่ม 5 ปุ่มให้อยู่ในแถวเดียวกันอย่างพอดี
