autoButton.MouseButton1ClientConnect = autoButton.MouseButton1Click:Connect(function()
	isAutoRunning = not isAutoRunning
	if isAutoRunning then
		autoButton.Text = "ปิด"
		autoButton.BackgroundColor3 = Color3.fromRGB(209, 105, 105)
		
		task.spawn(function()
			while isAutoRunning do
				runCode(1)
				task.wait(0.1)
			end
		end)
	else
		autoButton.Text = "เปิด"
		autoButton.BackgroundColor3 = Color3.fromRGB(56, 138, 52)
	end
end)

