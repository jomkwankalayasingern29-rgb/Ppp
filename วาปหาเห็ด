local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local fastTween = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- Open UI Animation
TweenService:Create(MainFrame, tweenInfo, {Size = UDim2.new(0, 280, 0, 280)}):Play()
TweenService:Create(UIStroke, fastTween, {Transparency = 0}):Play()

-- Button Hover Logic
local function setupHover(button, stroke, hoverColor, defaultColor)
    button.MouseEnter:Connect(function()
        TweenService:Create(button, fastTween, {BackgroundColor3 = Color3.fromRGB(35, 35, 48)}):Play()
        TweenService:Create(stroke, fastTween, {Color = hoverColor}):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(button, fastTween, {BackgroundColor3 = Color3.fromRGB(20, 20, 28)}):Play()
        TweenService:Create(stroke, fastTween, {Color = defaultColor}):Play()
    end)
end

setupHover(DiscordBtn, BtnStroke1, Color3.fromRGB(0, 220, 255), Color3.fromRGB(0, 150, 220))
setupHover(CloseBtn, BtnStroke2, Color3.fromRGB(255, 70, 70), Color3.fromRGB(70, 70, 90))

