end

local function createToggle(name, labelText, parentTab)
    local Frame = Instance.new("Frame")
    Frame.Name = name .. "Frame"
    Frame.Size = UDim2.new(0, 340, 0, 35)
    Frame.BackgroundTransparency = 1
    Frame.Parent = parentTab

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0, 240, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Text = labelText
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.Font = Enum.Font.Gotham
    Label.TextSize = 14
    Label.TextTransparency = 1
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame
    table.insert(allTextLabels, Label)

    local Button = Instance.new("TextButton")
    Button.Name = name .. "Button"
    Button.Size = UDim2.new(0, 60, 0, 28)
    Button.Position = UDim2.new(1, -75, 0, 3.5)
    Button.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    Button.BackgroundTransparency = 1
    Button.Text = "ปิด"
    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    Button.Font = Enum.Font.GothamBold
    Button.TextSize = 12
    Button.TextTransparency = 1
    Button.Parent = Frame
    table.insert(allButtons, Button)

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 4)
    Corner.Parent = Button

    return Button
end

