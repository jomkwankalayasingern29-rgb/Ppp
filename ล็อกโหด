-- 11. ระบบคำนวณเป้าหมายล็อก (AIMBOT LOGIC)
-- =============================================================================
local function getClosestTarget()
    local closestPart = nil
    local shortestMouseDist = math.huge
    local localCharacter = LocalPlayer.Character
    if not localCharacter or not localCharacter:FindFirstChild("HumanoidRootPart") then return nil end

    local function processModel(model, isNpc)
        local partName = nil
        if isNpc then
            if LockConfig.NPCHead then partName = "Head"
            elseif LockConfig.NPCTorso then partName = "HumanoidRootPart" end
        else
            if LockConfig.PlayerHead then partName = "Head"
            elseif LockConfig.PlayerTorso then partName = "HumanoidRootPart" end
        end
        
        if not partName then return end
        local part = model:FindFirstChild(partName)
        if not part and partName == "HumanoidRootPart" then
            part = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
        end

        if part and model:FindFirstChild("Humanoid") and model.Humanoid.Health > 0 then
            local partPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                local mouseDistance = (Vector2.new(partPos.X, partPos.Y) - screenCenter).Magnitude
                
                if mouseDistance <= FOV_Radius and mouseDistance < shortestMouseDist then
                    if not WallCheckEnabled or isVisible(part, model) then
                        shortestMouseDist = mouseDistance
                        closestPart = part
                    end
                end
            end
        end
    end

    if LockConfig.PlayerHead or LockConfig.PlayerTorso then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then processModel(player.Character, false) end
        end
    end

    if LockConfig.NPCHead or LockConfig.NPCTorso then
        for _, desc in ipairs(Workspace:GetDescendants()) do
            if desc:IsA("Model") and desc:FindFirstChild("Humanoid") and not Players:GetPlayerFromCharacter(desc) then
                if desc ~= localCharacter then processModel(desc, true) end
            end
        end
    end

    return closestPart
end

RunService.RenderStepped:Connect(function()
    local targetPart = getClosestTarget()
    if targetPart then
        local alpha = math.clamp(LockSpeed / 100, 0.02, 1)
        local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
        Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, alpha)
    end
end)
