-- 10. ระบบ 2D BOX & TRACERS ESP
-- =============================================================================
local Active2D = {}

local function createDrawingObject(model)
    if Active2D[model] then return end
    
    local box = Drawing.new("Square")
    box.Visible = false
    box.Thickness = 1.5
    box.Filled = false

    local tracer = Drawing.new("Line")
    tracer.Visible = false
    tracer.Thickness = 1.5

    Active2D[model] = {Box = box, Tracer = tracer}
end

local function removeDrawingObject(model)
    if Active2D[model] then
        Active2D[model].Box:Remove()
        Active2D[model].Tracer:Remove()
        Active2D[model] = nil
    end
end

RunService.RenderStepped:Connect(function()
    for model, _ in pairs(Active2D) do
        if not model or not model.Parent or not model:FindFirstChild("Humanoid") or model.Humanoid.Health <= 0 or not LockConfig.MasterEsp2D then
            removeDrawingObject(model)
        end
    end

    if not LockConfig.MasterEsp2D then return end

    -- ประมวลผล ESP คน
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local char = player.Character
            if LockConfig.PlayerEsp2D then
                createDrawingObject(char)
                
                local hrp = char.HumanoidRootPart
                local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                
                local colorToUse = isVisible(hrp, char) and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 255, 255)
                local data = Active2D[char]
                if data then
                    data.Box.Color = colorToUse
                    data.Tracer.Color = colorToUse

                    if onScreen then
                        local scale = 1 / (hrpPos.Z * math.tan(math.rad(Camera.FieldOfView * 0.5))) * 1000
                        local width, height = scale * 0.7, scale * 1.1
                        
                        data.Box.Size = Vector2.new(width, height)
                        data.Box.Position = Vector2.new(hrpPos.X - width/2, hrpPos.Y - height/2)
                        data.Box.Visible = true

                        data.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        data.Tracer.To = Vector2.new(hrpPos.X, hrpPos.Y + height/2)
                        data.Tracer.Visible = true
                    else
                        data.Box.Visible = false
                        data.Tracer.Visible = false
                    end
                end
            else
                removeDrawingObject(char)
            end
        end
    end

    -- ประมวลผล ESP NPC
    if LockConfig.NpcEsp2D then
        for _, desc in ipairs(Workspace:GetDescendants()) do
            if desc:IsA("Model") and desc:FindFirstChild("HumanoidRootPart") and desc:FindFirstChild("Humanoid") and desc.Humanoid.Health > 0 and not Players:GetPlayerFromCharacter(desc) then
                if desc ~= LocalPlayer.Character then
                    createDrawingObject(desc)
                    
                    local hrp = desc.HumanoidRootPart
                    local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    
                    local colorToUse = isVisible(hrp, desc) and Color3.fromRGB(0, 225, 255) or Color3.fromRGB(0, 50, 255)
                    local data = Active2D[desc]
                    if data then
                        data.Box.Color = colorToUse
                        data.Tracer.Color = colorToUse

                        if onScreen then
                            local scale = 1 / (hrpPos.Z * math.tan(math.rad(Camera.FieldOfView * 0.5))) * 1000
                            local width, height = scale * 0.7, scale * 1.1
                            
                            data.Box.Size = Vector2.new(width, height)
                            data.Box.Position = Vector2.new(hrpPos.X - width/2, hrpPos.Y - height/2)
                            data.Box.Visible = true

                            data.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                            data.Tracer.To = Vector2.new(hrpPos.X, hrpPos.Y + height/2)
                            data.Tracer.Visible = true
                        else
                            data.Box.Visible = false
                            data.Tracer.Visible = false
                        end
                    end
                end
            end
        end
    else
        for desc, _ in pairs(Active2D) do
