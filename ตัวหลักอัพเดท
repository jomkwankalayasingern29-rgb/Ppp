local ClayGraphicsEnabled = false
local originalMaterials = {}

local function applyClayMaterial()
    task.spawn(function()
        local count = 0
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and not obj:IsDescendantOf(Players) then
                if not originalMaterials[obj] then originalMaterials[obj] = obj.Material end
                pcall(function() obj.Material = Enum.Material.SmoothPlastic; obj.Reflectance = 0 end)
                count = count + 1
                if count % 200 == 0 then task.wait() end
            end
        end
    end)
end

local function restoreMaterials()
    task.spawn(function()
        for obj, mat in pairs(originalMaterials) do
            if obj and obj.Parent then pcall(function() obj.Material = mat end) end
        end
        originalMaterials = {}
    end)
end

