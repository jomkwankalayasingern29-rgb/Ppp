local FpsBoostEnabled = false
local effectConnection = nil
local function clearEffectsInObject(parentObj)
    for _, obj in ipairs(parentObj:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Explosion") or obj:IsA("Beam") or obj:IsA("Trail") then
            pcall(function() obj:Destroy() end)
        end
    end
end

