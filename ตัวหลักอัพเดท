        clearEffectsInObject(Workspace); clearEffectsInObject(Lighting)
        effectConnection = Workspace.DescendantAdded:Connect(function(obj)
            if FpsBoostEnabled and (obj:IsA("ParticleEmitter") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Explosion") or obj:IsA("Beam") or obj:IsA("Trail")) then
