local function executeUserCode(times)
    local code = CodeTextBox.Text
    if code == "" then
        showNotification("กรุณาใส่โค้ดก่อนกดรัน!", false)
        return
    end

    local func, err = loadstring(code)
    if not func then
        showNotification("โค้ดมีข้อผิดพลาด: " .. tostring(err), false)
        return
    end

    local successCount = 0
    for i = 1, times do
        local success, result = pcall(func)
        if success then successCount = successCount + 1 end
    end

    showNotification("รันโค้ดสำเร็จ " .. successCount .. " / " .. times .. " ครั้ง!", true)
end

