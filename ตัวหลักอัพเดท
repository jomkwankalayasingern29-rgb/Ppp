-- Sistema 2D ESP Con Clean Up
local Active2D = {}
local function removeDrawingObject(model)
    if Active2D[model] then
        if Active2D[model].Box then pcall(function() Active2D[model].Box:Remove() end) end
        if Active2D[model].Tracer then pcall(function() Active2D[model].Tracer:Remove() end) end
        Active2D[model] = nil
    end
end

local function clearAllDrawings() 
    for model, _ in pairs(Active2D) do removeDrawingObject(model) end 
end

RunService.RenderStepped:Connect(function()
    if not Drawing then return end
    if not ScreenGui.Parent or not LockConfig.MasterEsp2D then 
        if next(Active2D) then clearAllDrawings() end
        return 
    end

    for model, _ in pairs(Active2D) do
        if not model or not model.Parent or not model:FindFirstChild("Humanoid") or model.Humanoid.Health <= 0 then removeDrawingObject(model) end
    end

    local function drawESP(model, isNpc)
        if (isNpc and not LockConfig.NpcEsp2D) or (not isNpc and not LockConfig.PlayerEsp2D) then removeDrawingObject(model); return end
        if not Active2D[model] and Drawing then
            local box, tracer = Drawing.new("Square"), Drawing.new("Line")
            box.Visible = false; box.Thickness = 1.2; box.Filled = false
            tracer.Visible = false; tracer.Thickness = 1.2
            Active2D[model] = {Box = box, Tracer = tracer}
        end
        local hrp = model:FindFirstChild("HumanoidRootPart")
        if hrp then
            local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            local data = Active2D[model]
            if data then
                local col = isVisible(hrp, model) and (isNpc and Color3.fromRGB(0, 225, 255) or Color3.fromRGB(0, 255, 100)) or (isNpc and Color3.fromRGB(0, 50, 255) or Color3.fromRGB(255, 255, 255))
                data.Box.Color = col; data.Tracer.Color = col
                if onScreen then
                    local scale = 1 / (hrpPos.Z * math.tan(math.rad(Camera.FieldOfView * 0.5))) * 1000
                    local w, h = scale * 0.7, scale * 1.1
                    data.Box.Size = Vector2.new(w, h); data.Box.Position = Vector2.new(hrpPos.X - w/2, hrpPos.Y - h/2); data.Box.Visible = true
                    data.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y); data.Tracer.To = Vector2.new(hrpPos.X, hrpPos.Y + h/2); data.Tracer.Visible = true
                else
                    data.Box.Visible = false; data.Tracer.Visible = false
                end
            end
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then drawESP(player.Character, false) end
    end
    
    -- ใช้ GetChildren แทน GetDescendants เพื่อประหยัด CPU (FPS Drop Fix)
    for _, desc in ipairs(Workspace:GetChildren()) do
        if desc:IsA("Model") and desc:FindFirstChild("Humanoid") and desc.Humanoid.Health > 0 and not Players:GetPlayerFromCharacter(desc) and desc ~= LocalPlayer.Character then drawESP(desc, true) end
    end
end)

-- Optimized Target Finder
local function getClosestTarget()
    local closestPart, shortestDist = nil, math.huge
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return nil end

    if LockConfig.FullLock or LockConfig.FullLockTorso then
        local myRootPos = LocalPlayer.Character.HumanoidRootPart.Position
        local targetName = LockConfig.FullLock and "Head" or "HumanoidRootPart"
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild(targetName) and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                local part = p.Character[targetName]
                if not LockConfig.FullLockTorsoWallCheck or isVisible(part, p.Character) then
                    local dist = (part.Position - myRootPos).Magnitude
                    if dist < shortestDist then shortestDist = dist; closestPart = part end
                end
            end
        end
        return closestPart
    end

    local function processModel(model, isNpc)
        local pName = (isNpc and (LockConfig.NPCHead and "Head" or LockConfig.NPCTorso and "HumanoidRootPart")) or (LockConfig.PlayerHead and "Head" or LockConfig.PlayerTorso and "HumanoidRootPart")
        if not pName then return end
        local part = model:FindFirstChild(pName) or (pName == "HumanoidRootPart" and (model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")))
        if part and model:FindFirstChild("Humanoid") and model.Humanoid.Health > 0 then
            local partPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local screenDist = (Vector2.new(partPos.X, partPos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                if screenDist <= FOV_Radius and screenDist < shortestDist and (not WallCheckEnabled or isVisible(part, model)) then
                    shortestDist = screenDist; closestPart = part
                end
            end
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer and p.Character then processModel(p.Character, false) end end
    for _, d in ipairs(Workspace:GetChildren()) do if d:IsA("Model") and d:FindFirstChild("Humanoid") and not Players:GetPlayerFromCharacter(d) and d ~= LocalPlayer.Character then processModel(d, true) end end

    return closestPart
end

RunService.RenderStepped:Connect(function()
    if not ScreenGui.Parent then return end
    local anyLockEnabled = LockConfig.PlayerHead or LockConfig.PlayerTorso or LockConfig.NPCHead or LockConfig.NPCTorso or LockConfig.FullLock or LockConfig.FullLockTorso
    if not anyLockEnabled then return end
    
    local targetPart = getClosestTarget()
    if targetPart then 
        if LockConfig.FullLock or LockConfig.FullLockTorso then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
        else
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetPart.Position), math.clamp(LockSpeed / 100, 0.02, 1)) 
        end
    end
end)

