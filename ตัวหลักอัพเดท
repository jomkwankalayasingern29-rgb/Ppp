    if RemoveJunkEnabled then
        for _, obj in ipairs(Workspace:GetDescendants()) do if isJunkPart(obj) then pcall(function() obj:Destroy() end) end end
        junkConnection = Workspace.DescendantAdded:Connect(function(obj)
            if RemoveJunkEnabled and isJunkPart(obj) then
                task.spawn(function() task.wait(0.05); pcall(function() obj:Destroy() end) end)
            end
        end)
    else
        if junkConnection then junkConnection:Disconnect(); junkConnection = nil end
    end
end)

