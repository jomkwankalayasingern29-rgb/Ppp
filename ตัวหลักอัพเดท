            end
        end)
    else
        if effectConnection then effectConnection:Disconnect(); effectConnection = nil end
    end
end)

local RemoveJunkEnabled = false
local junkConnection = nil
local function isJunkPart(obj)
    if obj:IsA("BasePart") then
        local nameLower = string.lower(obj.Name)
        if string.find(nameLower, "rock") or string.find(nameLower, "stone") or string.find(nameLower, "debris") or string.find(nameLower, "fx") or string.find(nameLower, "impact") or string.find(nameLower, "dust") or string.find(nameLower, "hit") then
            if not obj:IsDescendantOf(Players) and obj.Parent ~= Workspace then return true end
        end
    end
    return false
end

RemoveJunkToggle.MouseButton1Click:Connect(function()
    RemoveJunkEnabled = not RemoveJunkEnabled
    RemoveJunkToggle.BackgroundColor3 = RemoveJunkEnabled and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
