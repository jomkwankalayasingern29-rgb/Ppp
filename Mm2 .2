-- เพิ่ม Slider ในหมวดหมู่ UI: 2) ปรับขนาดความใหญ่ UI (50% - 150%)
CreateSlider(UIPage, "ปรับขนาดความใหญ่ UI", 50, 150, 100, "%", function(val)
    currentScale = val / 100
    local newW = baseWidth * currentScale
    local newH = baseHeight * currentScale
    MainFrame.Size = UDim2.new(0, newW, 0, newH)
