-- 12. ระบบ Animation ย่อ/กาง UI เข้าหาไอคอน D
local isOpen = false
local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

local function ToggleUI()
    isOpen = not isOpen
    if isOpen then
        MainFrame.Visible = true
        MainFrame.Size = UDim2.new(0, 40, 0, 40)
        MainFrame.Position = ToggleBtn.Position
        MainFrame.BackgroundTransparency = 1
        
        local targetW = baseWidth * currentScale
        local targetH = baseHeight * currentScale
        
        TweenService:Create(MainFrame, tweenInfo, {
            Size = UDim2.new(0, targetW, 0, targetH),
            Position = UDim2.new(0.5, -targetW/2, 0.5, -targetH/2),
            BackgroundTransparency = 1 - currentAlpha
        }):Play()
    else
        local closeTween = TweenService:Create(MainFrame, tweenInfo, {
            Size = UDim2.new(0, 40, 0, 40),
            Position = ToggleBtn.Position,
            BackgroundTransparency = 1
        })
        closeTween:Play()
        closeTween.Completed:Connect(function()
            if not isOpen then MainFrame.Visible = false end
        end)
    end
end

ToggleBtn.MouseButton1Click:Connect(ToggleUI)
MinBtn.MouseButton1Click:Connect(ToggleUI)

-- ระบบลากหน้าต่างผ่าน TopBar
local Dragging, DragStart, StartPos
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        Dragging = true; DragStart = input.Position; StartPos = MainFrame.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - DragStart
        MainFrame.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + delta.X, StartPos.Y.Scale, StartPos.Y.Offset + delta.Y)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then Dragging = false end
end)
