            local stroke = Instance.new("UIStroke", miniShootGui)
            stroke.Color = Color3.fromRGB(255, 50, 50)
            stroke.Thickness = 1.5

            local shootBtn = Instance.new("TextButton", miniShootGui)
            shootBtn.Size = UDim2.new(1, -10, 1, -10)
            shootBtn.Position = UDim2.new(0, 5, 0, 5)
            shootBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
            shootBtn.Text = "ยิงทันที! (INSTANT)"
            shootBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            shootBtn.Font = Enum.Font.GothamBold
            shootBtn.TextSize = 11
