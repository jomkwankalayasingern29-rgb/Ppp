RunService.RenderStepped:Connect(function()
    for _, v in pairs(espTextObjects) do 
        pcall(function() v:Remove() end) 
    end
    espTextObjects = {}

    if not espEnabled then return end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local character = player.Character
            local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
            
            if head then
                local headWorldPos = head.Position + Vector3.new(0, 1.8, 0)
                local pos, onScreen = Camera:WorldToViewportPoint(headWorldPos)

                local charKnife, charGun = ScanTools(character)
                local packKnife, packGun = ScanTools(player:FindFirstChild("Backpack"))

                local hasKnife = charKnife or packKnife
                local hasGun = charGun or packGun

                local color = Color3.fromRGB(80, 200, 100) -- เขียว (ปกติ)

                if hasKnife then
                    color = Color3.fromRGB(220, 80, 80) -- แดง (มีด)
                elseif hasGun then
                    color = Color3.fromRGB(80, 150, 220) -- ฟ้า (ปืน)
                end

                -- ไฮไลต์ตัวละคร (Highlight)
                local highlight = character:FindFirstChild("ESPHighlight")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "ESPHighlight"
                    highlight.Parent = character
                end
                highlight.FillColor = color
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.5
                highlight.OutlineTransparency = 0.2

                -- แสดงชื่อผู้เล่นบนหัว
                if onScreen then
                    local textObj = Drawing.new("Text")
                    textObj.Text = player.Name
                    textObj.Color = color
                    textObj.Position = Vector2.new(pos.X, pos.Y)
                    textObj.Center = true
                    textObj.Outline = true
                    textObj.Size = 15
                    textObj.Visible = true
                    table.insert(espTextObjects, textObj)
                end
            end
        end
    end
end)

