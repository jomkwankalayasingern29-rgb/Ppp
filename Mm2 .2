-- ฟังก์ชันยิงพุ่งเป้าอัตโนมัติแบบทันที (Silent Aim / Instant Hit)
local function TriggerInstantShoot()
    local myChar = LocalPlayer.Character
    if not myChar then return end

    -- ค้นหาปืนในตัวหรือดึงมาจาก Backpack ทันที
    local currentTool = myChar:FindFirstChildWhichIsA("Tool")
    if not currentTool or not (string.find(string.lower(currentTool.Name), "gun") or currentTool:FindFirstChild("GunScript")) then
        for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
            if item:IsA("Tool") then
                local name = string.lower(item.Name)
                if string.find(name, "gun") or string.find(name, "pistol") or string.find(name, "revolver") or item:FindFirstChild("Gun") then
                    item.Parent = myChar
                    currentTool = item
                    break
                end
            end
        end
    end

    if not currentTool then return end

    local targetHead = nil

    -- ค้นหาตัวฆาตกรที่มีมีด
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local charKnife, _ = ScanTools(p.Character)
            local packKnife, _ = ScanTools(p:FindFirstChild("Backpack"))
            
            if charKnife or packKnife then
                local head = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
                if head then
                    targetHead = head
                    break
                end
            end
        end
    end

    if targetHead then
        -- ค้นหา RemoteEvent ของปืนในเกม MM2 เพื่อสั่งยิงไปที่พิกัดหัวของเป้าหมายทันทีโดยไม่ต้องเล็ง
        local gunRemote = nil
        for _, desc in pairs(currentTool:GetDescendants()) do
            if desc:IsA("RemoteEvent") then
                local rName = string.lower(desc.Name)
                if rName:find("shoot") or rName:find("gun") or rName:find("fire") or rName:find("hit") then
                    gunRemote = desc
                    break
                end
            end
        end

        if gunRemote then
            -- ส่งพิกัดตำแหน่งหัวเป้าหมายผ่าน Remote ไปยังเซิร์ฟเวอร์โดยตรง กระสุนจะพุ่งเข้าหาเป้าหมายทันที
            gunRemote:FireServer(targetHead.Position)
        else
            -- ทางเลือกเสริม: บังคับยิงผ่าน Tool Activate
            currentTool:Activate()
        end
    end
end

