-- 2. ฟาร์มอีเวนต์อัตโนมัติ
addToggle("ฟามอีเว้นอัตโนมัติ", function(state)
    activeAutoFarm = state
    if state then
        task.spawn(function()
            while activeAutoFarm do
                task.wait(0.2)
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    local targetPos, targetPrompt = nil, nil

                    for _, p in ipairs(Workspace:GetDescendants()) do
                        if p:IsA("ProximityPrompt") and p.Enabled then
                            local parent = p.Parent
                            if parent then
                                local name = string.lower(parent.Name)
                                if string.find(name, "mushroom") or string.find(name, "token") then
                                    targetPos = parent:IsA("BasePart") and parent.Position or (parent:IsA("Model") and parent:GetPivot().Position)
                                    targetPrompt = p
                                    break
                                end
                            end
                        end
                    end

                    if targetPos and targetPrompt then
                        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
                        task.wait(0.1)
                        pcall(function() fireproximityprompt(targetPrompt) end)
                        if savedPosition then
                            task.wait(0.05)
                            hrp.CFrame = savedPosition
                        end
                    end
                end
            end
        end)
    end
end)

