​local function createToggleRow(parent, labelText, callback)
local state = false
local btn = createButtonRow(parent, labelText, "ปิด (OFF)", function(b)
state = not state
b.Text = state and "เปิด (ON)" or "ปิด (OFF)"
b.TextColor3 = state and Color3.fromRGB(80, 255, 100) or Color3.fromRGB(0, 162, 255)
callback(state, b)
end)
return btn
end
