-- 7. หมวด "ESP" (ครบถ้วนทุกระบบสแกนมีด/ปืน/ปืนตกพื้น)
local ESPPage = createContainer("ESP")
createToggleOption(ESPPage, "เปิดใช้งาน ESP ไฮไลท์", false, function(state)
    _G.ESPPlayer = state
    if not state then
        for _, player in pairs(Players:GetPlayers()) do
            if player.Character then
                local hl = player.Character:FindFirstChild("ESPHighlight")
                if hl then hl:Destroy() end
            end
        end
    end
end)

createToggleOption(ESPPage, "ESPปืนตกพื้น (เฉพาะบนพื้น)", false, function(state)
    _G.ESPGun = state
    if not state then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj.Name == "GunDropHighlight" then obj:Destroy() end
        end
    end
end)

local espTextObjects = {}
local function ScanTools(container)
    local foundKnife, foundGun = false, false
    if container then
        for _, item in pairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local name = string.lower(item.Name)
                if string.find(name, "knife") or string.find(name, "dagger") or string.find(name, "blade") or item:FindFirstChild("Knife") then
                    foundKnife = true
                elseif string.find(name, "gun") or string.find(name, "pistol") or string.find(name, "revolver") or item:FindFirstChild("Gun") then
                    foundGun = true
                end
            end
        end
    end
    return foundKnife, foundGun
end

RunService.RenderStepped:Connect(function()
    for _, textObj in pairs(espTextObjects) do
        textObj:Remove()
    end
    espTextObjects = {}

    if _G.ESPPlayer then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local character = player.Character
                local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
                
                if head then
                    local pos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.8, 0))
                    local charKnife, charGun = ScanTools(character)
                    local packKnife, packGun = ScanTools(player:FindFirstChild("Backpack"))

                    local color = Color3.fromRGB(80, 200, 100)
                    if charKnife or packKnife then
                        color = Color3.fromRGB(220, 80, 80)
                    elseif charGun or packGun then
                        color = Color3.fromRGB(80, 150, 220)
                    end

                    local highlight = character:FindFirstChild("ESPHighlight")
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "ESPHighlight"
                        highlight.Parent = character
                    end
                    highlight.FillColor = color
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0.2

                    if onScreen then
                        local textObj = Drawing.new("Text")
                        textObj.Text = player.Name
                        textObj.Color = color
                        textObj.Position = Vector2.new(pos.X, pos.Y)
                        textObj.Center = true
                        textObj.Outline = true
                        textObj.Size = 14
                        textObj.Visible = true
                        table.insert(espTextObjects, textObj)
                    end
                end
            end
        end
    end

    if _G.ESPGun then
        for _, obj in pairs(Workspace:GetDescendants()) do
            local isDroppedGun = false
            if obj:IsA("Tool") or obj:IsA("Model") then
                local n = string.lower(obj.Name)
                if n:find("gun") or n:find("pistol") or n:find("revolver") or n:find("dropped") then
                    local ancestor = obj.Parent
                    local isInPlayer = false
                    while ancestor and ancestor ~= game do
                        if ancestor:IsA("Model") and Players:GetPlayerFromCharacter(ancestor) then
                            isInPlayer = true
                            break
                        elseif ancestor:IsA("Backpack") then
                            isInPlayer = true
                            break
                        end
                        ancestor = ancestor.Parent
                    end
                    if not isInPlayer then isDroppedGun = true end
                end
            end

            if isDroppedGun then
                local targetPart = nil
                if obj:IsA("Model") then
                    targetPart = obj.PrimaryPart or obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
                elseif obj:IsA("Tool") then
                    targetPart = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
                end
                
                if targetPart and not targetPart:FindFirstChild("GunDropHighlight") then
                    local gunHighlight = Instance.new("Highlight")
                    gunHighlight.Name = "GunDropHighlight"
                    gunHighlight.FillColor = Color3.fromRGB(255, 220, 0)
                    gunHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    gunHighlight.FillTransparency = 0.3
                    gunHighlight.OutlineTransparency = 0.1
                    gunHighlight.Parent = targetPart
                end
            end
        end
    end
end)

-- ฟังก์ชันสลับหมวดหมู่
local function switchTab(tabName)
    for name, container in pairs(FunctionContainers) do
        container.Visible = (name == tabName)
    end
end

-- สร้างปุ่มเลือกหมวดหมู่ทางซ้าย
local function createCategoryButton(name)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 26)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.Gotham
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(240, 240, 240)
    btn.TextSize = 10
    btn.Parent = LeftSide

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        switchTab(name)
    end)
end

