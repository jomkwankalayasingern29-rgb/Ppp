local function GetPlayerRole(player)
    local function ScanTools(container)
        if not container then return false, false end
        local hasKnife, hasGun = false, false
        for _, item in pairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local n = string.lower(item.Name)
                if n:find("knife") or n:find("dagger") or n:find("blade") then hasKnife = true end
                if n:find("gun") or n:find("pistol") or n:find("revolver") then hasGun = true end
            end
        end
        return hasKnife, hasGun
    end

    local cKnife, cGun = ScanTools(player.Character)
    local bKnife, bGun = ScanTools(player.Backpack)

    if cKnife or bKnife then
        return "ฆาตกร", Color3.fromRGB(255, 60, 60)
    elseif cGun or bGun then
        return "นายอำเภอ", Color3.fromRGB(0, 162, 255)
    else
        return "ผู้บริสุทธิ์", Color3.fromRGB(220, 220, 220)
    end
end

local function AddKillFeedMessage(killer, victim, weaponName)
    if not killFeedEnabled then return end
    task.spawn(function()
        local kRole, kColor = GetPlayerRole(killer)
        local vRole, vColor = GetPlayerRole(victim)

        local ItemFrame = Instance.new("Frame", KillFeedContainer)
        ItemFrame.Size = UDim2.new(1, 0, 0, 32)
        ItemFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
        ItemFrame.BackgroundTransparency = 0.2
        ItemFrame.Position = UDim2.new(-1.2, 0, 0, 0)
        ItemFrame.ClipsDescendants = true

        Instance.new("UICorner", ItemFrame).CornerRadius = UDim.new(0, 6)
        local stroke = Instance.new("UIStroke", ItemFrame)
        stroke.Color = kColor
        stroke.Thickness = 1.2

        local KillerHead = Instance.new("ImageLabel", ItemFrame)
        KillerHead.Size = UDim2.new(0, 24, 0, 24)
        KillerHead.Position = UDim2.new(0, 4, 0.5, -12)
        KillerHead.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        Instance.new("UICorner", KillerHead).CornerRadius = UDim.new(1, 0)

        -- ดึงรูปโปรไฟล์แบบแยกเธรด ป้องกันเกมค้าง
        task.spawn(function()
            pcall(function()
                local content = Players:GetUserThumbnailAsync(killer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
                KillerHead.Image = content
            end)
        end)

        local MsgLabel = Instance.new("TextLabel", ItemFrame)
        MsgLabel.Size = UDim2.new(1, -34, 1, 0)
        MsgLabel.Position = UDim2.new(0, 32, 0, 0)
        MsgLabel.BackgroundTransparency = 1
        MsgLabel.Font = Enum.Font.GothamBold
        MsgLabel.TextSize = 10
        MsgLabel.TextXAlignment = Enum.TextXAlignment.Left

        if killer == victim then
            MsgLabel.Text = killer.Name .. " ตายด้วยตนเอง (" .. weaponName .. ")"
            MsgLabel.TextColor3 = vColor
        else
            MsgLabel.Text = killer.Name .. " ฆ่า " .. victim.Name .. " ด้วย " .. weaponName
            MsgLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        end

        local tweenIn = TweenService:Create(ItemFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 0, 0, 0)
        })
        tweenIn:Play()

        task.wait(2)

        local tweenOut = TweenService:Create(ItemFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            BackgroundTransparency = 1,
            Position = UDim2.new(-1.2, 0, 0, 0)
        })
        local strokeFade = TweenService:Create(stroke, TweenInfo.new(0.4), {Transparency = 1})
        local textFade = TweenService:Create(MsgLabel, TweenInfo.new(0.4), {TextTransparency = 1})
        
        tweenOut:Play()
        strokeFade:Play()
        textFade:Play()

        tweenOut.Completed:Connect(function()
            ItemFrame:Destroy()
        end)
    end)
end

local function MonitorPlayer(player)
    player.CharacterAdded:Connect(function(char)
        local humanoid = char:WaitForChild("Humanoid", 5)
        if humanoid then
            humanoid.Died:Connect(function()
                local killer = player
                local weapon = "ความตาย"
                
                for _, other in pairs(Players:GetPlayers()) do
                    if other ~= player and other.Character and other.Character:FindFirstChild("HumanoidRootPart") then
                        local oRoot = other.Character.HumanoidRootPart
                        local pRoot = char:FindFirstChild("HumanoidRootPart")
                        if pRoot and (oRoot.Position - pRoot.Position).Magnitude < 35 then
                            killer = other
                            local kKnife, kGun = GetPlayerRole(other)
                            if kKnife == "ฆาตกร" then weapon = "มีด" 
                            elseif kGun == "นายอำเภอ" then weapon = "ปืน" 
                            else weapon = "อาวุธ" end
                            break
                        end
                    end
                end

                AddKillFeedMessage(killer, player, weapon)
            end)
        end
    end)
end

for _, p in pairs(Players:GetPlayers()) do
