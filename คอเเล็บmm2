local function ScanTools(container)
    local foundKnife, foundGun = false, false
    if container then
        for _, item in pairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local name = string.lower(item.Name)
                if string.find(name, "knife") or string.find(name, "dagger") or string.find(name, "blade") then
                    foundKnife = true
                elseif string.find(name, "gun") or string.find(name, "pistol") or string.find(name, "revolver") then
                    foundGun = true
                end
            end
        end
    end
    return foundKnife, foundGun
end

RunService.RenderStepped:Connect(function()
    if espEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local character = player.Character
                local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
                if head then
                    local charKnife, charGun = ScanTools(character)
                    local bp = player:FindFirstChild("Backpack")
                    local packKnife, packGun = false, false
                    if bp then
                        packKnife, packGun = ScanTools(bp)
                    end

                    local color = Color3.fromRGB(200, 200, 200)
                    if charKnife or packKnife then color = Color3.fromRGB(255, 60, 60)
                    elseif charGun or packGun then color = Color3.fromRGB(0, 162, 255) end

                    local highlight = character:FindFirstChild("ESPHighlight")
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "ESPHighlight"
                        highlight.Parent = character
                    end
                    highlight.FillColor = color
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0.2
                end
            end
        end
    end
end)

