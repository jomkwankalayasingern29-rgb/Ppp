local function ShowDeathFeed(killerName, killerRole, victimName, victimRole, weaponEmoji)
    if not KillFeedHolder.Visible then return end

    local FeedItem = Instance.new("Frame", KillFeedHolder)
    FeedItem.Size = UDim2.new(1, 0, 0, 30)
    FeedItem.BackgroundColor3 = Color3.fromRGB(10, 10, 12) -- แถบสีดำ
    FeedItem.BackgroundTransparency = 0.2
    FeedItem.ZIndex = 6
    Instance.new("UICorner", FeedItem).CornerRadius = UDim.new(0, 6)

    local Stroke = Instance.new("UIStroke", FeedItem)
    Stroke.Color = Color3.fromRGB(40, 40, 50)
    Stroke.Thickness = 1.2

    local Label = Instance.new("TextLabel", FeedItem)
    Label.Size = UDim2.new(1, -10, 1, 0)
    Label.Position = UDim2.new(0, 8, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Font = Enum.Font.GothamBold
    Label.TextSize = 11
    Label.TextColor3 = Color3.fromRGB(240, 240, 240)
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.RichText = true
    Label.ZIndex = 7

    -- กำหนดสีชื่อตามบทบาท (ฆาตกร=แดง, นายอำเภอ=ฟ้า, ผู้บริสุทธิ์=เขียว)
    local function getRoleColorHex(role)
        if role == 1 then return "#FF3C3C" -- สีแดง (ฆาตกร)
        elseif role == 2 then return "#00A2FF" -- สีฟ้า (นายอำเภอ)
        else return "#50DC64" end -- สีเขียว (ผู้บริสุทธิ์)
    end

    local kColor = getRoleColorHex(killerRole)
    local vColor = getRoleColorHex(victimRole)

    if killerName then
        Label.Text = string.format("<font color=\"%s\"><b>%s</b></font> %s <font color=\"%s\"><b>%s</b></font>", kColor, killerName, weaponEmoji, vColor, victimName)
    else
        Label.Text = string.format("<font color=\"%s\"><b>%s</b></font> เสียชีวิตแล้ว 💀", vColor, victimName)
    end

    task.spawn(function()
        task.wait(3)
        local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        pcall(function()
            TweenService:Create(FeedItem, tweenInfo, {BackgroundTransparency = 1}):Play()
            TweenService:Create(Label, tweenInfo, {TextTransparency = 1}):Play()
            TweenService:Create(Stroke, tweenInfo, {Transparency = 1}):Play()
        end)
        task.wait(0.5)
        FeedItem:Destroy()
    end)
end

