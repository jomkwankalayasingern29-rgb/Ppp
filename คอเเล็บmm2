local espTextObjects = {}
local function ScanTools(container)
    local foundKnife, foundGun = false, false
    if container then
        for _, item in pairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local name = string.lower(item.Name)
                if name:find("knife") or name:find("dagger") or name:find("blade") then foundKnife = true
                elseif name:find("gun") or name:find("pistol") or name:find("revolver") then foundGun = true end
            end
        end
    end
    return foundKnife, foundGun
end

RunService.RenderStepped:Connect(function()
    for _, textObj in pairs(espTextObjects) do textObj:Remove() end
    espTextObjects = {}

    if _G.ESPPlayer then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                if head then
                    local pos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.8, 0))
                    local cKnife, cGun = ScanTools(char)
                    local pKnife, pGun = ScanTools(player:FindFirstChild("Backpack"))
                    
                    local color = Color3.fromRGB(80, 200, 100)
                    if cKnife or pKnife then color = Color3.fromRGB(220, 80, 80)
                    elseif cGun or pGun then color = Color3.fromRGB(80, 150, 220) end

                    local hl = char:FindFirstChild("ESPHighlight")
                    if not hl then
                        hl = Instance.new("Highlight", char)
                        hl.Name = "ESPHighlight"
                    end
                    hl.FillColor = color
                    hl.FillTransparency = 0.5

                    if onScreen then
                        local t = Drawing.new("Text")
                        t.Text = player.Name
                        t.Color = color
                        t.Position = Vector2.new(pos.X, pos.Y)
                        t.Center = true
                        t.Outline = true
                        t.Size = 14
                        t.Visible = true
                        table.insert(espTextObjects, t)
                    end
                end
            end
        end
    end

    if _G.ESPGun then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if (obj:IsA("Tool") or obj:IsA("Model")) and (string.lower(obj.Name):find("gun") or string.lower(obj.Name):find("revolver")) then
                local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChild("Handle")) or obj:FindFirstChild("Handle")
                if part and not part:FindFirstChild("GunDropHighlight") then
                    local hl = Instance.new("Highlight", part)
                    hl.Name = "GunDropHighlight"
                    hl.FillColor = Color3.fromRGB(255, 220, 0)
                    hl.FillTransparency = 0.3
                end
            end
        end
    end
end)

