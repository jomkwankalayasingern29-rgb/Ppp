local function ScanToolsForRole(container)
    if not container then return false, false end
    local hasKnife, hasGun = false, false
    for _, item in pairs(container:GetChildren()) do
        if item:IsA("Tool") then
            local n = string.lower(item.Name)
            if n:find("knife") or n:find("dagger") or n:find("blade") then hasKnife = true end
            if n:find("gun") or n:find("pistol") or n:find("revolver") then hasGun = true end
        end
    end
    return hasKnife, hasGun
end

local playerCardPool = {}
local playerLastState = {}

task.spawn(function()
    while true do
        pcall(function()
            local aliveCount = 0
            local deadCount = 0
            local playerRoleData = {}

            for _, player in pairs(Players:GetPlayers()) do
                local char = player.Character
                local isAlive = false
                
                if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                    local head = char:FindFirstChild("Head")
                    if not head or head.Transparency < 1 then
                        isAlive = true
                        aliveCount = aliveCount + 1
                    else
                        deadCount = deadCount + 1
                    end
                else
                    deadCount = deadCount + 1
                end

                local cKnife, cGun = ScanToolsForRole(char)
                local bKnife, bGun = false, false
                local bp = player:FindFirstChild("Backpack")
                if bp then
                    bKnife, bGun = ScanToolsForRole(bp)
                end
                
                local roleType = 3
                local roleNameStr = "ผู้บริสุทธิ์"
                local roleColor = Color3.fromRGB(80, 220, 100)

                if cKnife or bKnife then
                    roleType = 1
                    roleNameStr = "ฆาตกร"
                    roleColor = Color3.fromRGB(255, 60, 60)
                elseif cGun or bGun then
                    roleType = 2
                    roleNameStr = "นายอำเภอ"
                    roleColor = Color3.fromRGB(0, 162, 255)
                end

                if playerLastState[player] == nil then
                    playerLastState[player] = isAlive
                elseif playerLastState[player] == true and not isAlive then
                    -- ตรวจสอบหาว่าใครเป็นคนฆ่า (เช็คจากฆาตกรหรือนายอำเภอในแมพ)
                    local killer = nil
                    local killerRole = 1
                    local weapon = "🔪"
                    
                    if roleType == 1 then
                        -- ฆาตกรตายเองหรือถูกยิง
                        weapon = "🔫"
                    else
                        -- ค้นหาฆาตกรในแมพมาเป็นคนจัดการ
                        for _, p in pairs(Players:GetPlayers()) do
                            if p ~= player and p.Character then
                                local pk, pg = ScanToolsForRole(p.Character)
                                local pbp = p:FindFirstChild("Backpack")
                                if pbp then
                                    local pbpk, pbpg = ScanToolsForRole(pbp)
                                    pk = pk or pbpk
                                end
                                if pk then
                                    killer = p.Name
                                    killerRole = 1
                                    weapon = "🔪"
                                    break
                                end
                            end
                        end
                    end
                    
                    ShowDeathFeed(killer, killerRole, player.Name, roleType, weapon)
                end
                playerLastState[player] = isAlive

                table.insert(playerRoleData, {
                    Player = player,
                    IsAlive = isAlive,
                    RoleType = roleType,
                    RoleName = roleNameStr,
                    RoleColor = roleColor
                })
            end

            HeaderSummary.Text = string.format("ผู้รอดชีวิต: %d คน | ตายไปแล้ว: %d คน", aliveCount, deadCount)

            table.sort(playerRoleData, function(a, b)
                if a.RoleType ~= b.RoleType then
                    return a.RoleType < b.RoleType
                end
                return a.Player.Name < b.Player.Name
            end)

            for _, card in pairs(playerCardPool) do
                card.Visible = false
            end

            for i, data in ipairs(playerRoleData) do
                local pCard = playerCardPool[i]
                if not pCard then
                    pCard = Instance.new("Frame", StatusContainer)
                    pCard.Size = UDim2.new(0.96, 0, 0, 32)
                    pCard.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
                    pCard.ZIndex = 6
                    Instance.new("UICorner", pCard).CornerRadius = UDim.new(0, 5)

                    local headshot = Instance.new("ImageLabel", pCard)
                    headshot.Name = "Headshot"
                    headshot.Size = UDim2.new(0, 24, 0, 24)
                    headshot.Position = UDim2.new(0, 4, 0.5, -12)
                    headshot.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
                    headshot.ZIndex = 7
                    Instance.new("UICorner", headshot).CornerRadius = UDim.new(1, 0)

                    local deadX = Instance.new("TextLabel", headshot)
                    deadX.Name = "DeadX"
                    deadX.Size = UDim2.new(1, 0, 1, 0)
                    deadX.BackgroundTransparency = 1
                    deadX.Text = "X"
                    deadX.TextColor3 = Color3.fromRGB(255, 50, 50)
                    deadX.Font = Enum.Font.GothamBold
                    deadX.TextSize = 16
                    deadX.TextXAlignment = Enum.TextXAlignment.Center
                    deadX.TextYAlignment = Enum.TextYAlignment.Center
                    deadX.ZIndex = 8

                    local nameLabel = Instance.new("TextLabel", pCard)
                    nameLabel.Name = "NameLabel"
                    nameLabel.Size = UDim2.new(0.6, 0, 1, 0)
                    nameLabel.Position = UDim2.new(0, 34, 0, 0)
                    nameLabel.BackgroundTransparency = 1
                    nameLabel.Font = Enum.Font.GothamBold
                    nameLabel.TextSize = 10
                    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
                    nameLabel.ZIndex = 7

                    local stateLabel = Instance.new("TextLabel", pCard)
                    stateLabel.Name = "StateLabel"
                    stateLabel.Size = UDim2.new(0.3, 0, 1, 0)
                    stateLabel.Position = UDim2.new(0.68, 0, 0, 0)
                    stateLabel.BackgroundTransparency = 1
                    stateLabel.Font = Enum.Font.GothamBold
                    stateLabel.TextSize = 10
                    stateLabel.TextXAlignment = Enum.TextXAlignment.Right
                    stateLabel.ZIndex = 7

                    playerCardPool[i] = pCard
                end

                pCard.Visible = true
                pCard.LayoutOrder = i

                local headshot = pCard:FindFirstChild("Headshot")
                local deadX = headshot and headshot:FindFirstChild("DeadX")
                local nameLabel = pCard:FindFirstChild("NameLabel")
                local stateLabel = pCard:FindFirstChild("StateLabel")

                if headshot then
                    pcall(function()
                        local content, isReady = Players:GetUserThumbnailAsync(data.Player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
                        if isReady then headshot.Image = content end
                    end)
                end

                if deadX then
                    deadX.Visible = not data.IsAlive
                end

                if nameLabel then
                    nameLabel.Text = data.Player.Name .. " (" .. data.RoleName .. ")"
                    nameLabel.TextColor3 = data.RoleColor
                end

                if stateLabel then
                    stateLabel.Text = data.IsAlive and "รอดชีวิต" or "ตายแล้ว"
                    stateLabel.TextColor3 = data.IsAlive and Color3.fromRGB(80, 220, 100) or Color3.fromRGB(220, 80, 80)
                end
            end
        end)
        task.wait(1)
    end
end)

