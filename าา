    if num and num > 0 then speedMultiplier = num flySpeedBox.Text = tostring(speedMultiplier) else flySpeedBox.Text = tostring(speedMultiplier) end
end)

_G.WalkSpeedToggle = false
_G.WalkSpeedVal = 50

_G.JumpPowerToggle = false
_G.JumpPowerVal = 100

_G.InfJumpToggle = false
_G.NoclipToggle = false
_G.InstantPromptToggle = false

speedToggleBtn.MouseButton1Click:Connect(function()
    _G.WalkSpeedToggle = not _G.WalkSpeedToggle
    speedToggleBtn.Text = _G.WalkSpeedToggle and "ON" or "OFF"
    speedToggleBtn.BackgroundColor3 = _G.WalkSpeedToggle and Color3.fromRGB(0, 162, 255) or Color3.fromRGB(255, 255, 255)
    
    if not _G.WalkSpeedToggle and lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") then
        lp.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = 16
    end
end)

walkSpeedBox.FocusLost:Connect(function()
    local num = tonumber(walkSpeedBox.Text)
    if num and num > 0 then _G.WalkSpeedVal = num else walkSpeedBox.Text = tostring(_G.WalkSpeedVal) end
end)

jumpToggleBtn.MouseButton1Click:Connect(function()
    _G.JumpPowerToggle = not _G.JumpPowerToggle
    jumpToggleBtn.Text = _G.JumpPowerToggle and "ON" or "OFF"
    jumpToggleBtn.BackgroundColor3 = _G.JumpPowerToggle and Color3.fromRGB(0, 162, 255) or Color3.fromRGB(255, 255, 255)
    
    if not _G.JumpPowerToggle and lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") then
        local hum = lp.Character:FindFirstChildOfClass("Humanoid")
        hum.UseJumpPower = true
        hum.JumpPower = 50
    end
end)

jumpPowerBox.FocusLost:Connect(function()
    local num = tonumber(jumpPowerBox.Text)
    if num and num > 0 then _G.JumpPowerVal = num else jumpPowerBox.Text = tostring(_G.JumpPowerVal) end
end)

infJumpToggleBtn.MouseButton1Click:Connect(function()
    _G.InfJumpToggle = not _G.InfJumpToggle
    infJumpToggleBtn.Text = _G.InfJumpToggle and "ON" or "OFF"
    infJumpToggleBtn.BackgroundColor3 = _G.InfJumpToggle and Color3.fromRGB(0, 162, 255) or Color3.fromRGB(255, 255, 255)
