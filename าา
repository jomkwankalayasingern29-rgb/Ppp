task.spawn(function()
    while task.wait(0.5) do
        if _G.AutoFarm then
            pcall(function()
                local char = lp.Character
                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
                    local hrp = char.HumanoidRootPart
                    local hum = char:FindFirstChildOfClass("Humanoid")

                    if hum.Health > 0 then
                        local bv = Instance.new("BodyVelocity")
                        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                        bv.Velocity = Vector3.new(0, 0, 0)
                        bv.Parent = hrp

                        local stages = ws:WaitForChild("BoatStages"):WaitForChild("NormalStages")
                        local height = _G.FlyHeight or 45
                        local speed = _G.FarmSpeed or 230

                        for i = 1, 10 do
                            if not _G.AutoFarm or hum.Health <= 0 then break end
                            local stage = stages:FindFirstChild("CaveStage" .. i)
                            if stage and stage:FindFirstChild("DarknessPart") then
                                local darknessPart = stage.DarknessPart
                                local targetCFrame = darknessPart.CFrame * CFrame.new(0, height, 0)
                                local dist = (hrp.Position - targetCFrame.Position).Magnitude
                                
                                local tween = ts:Create(hrp, TweenInfo.new(dist / speed, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
                                tween:Play()
                                tween.Completed:Wait()

                                firetouchinterest(hrp, darknessPart, 0)
                                task.wait(0.05)
                                firetouchinterest(hrp, darknessPart, 1)
                            end
                        end

                        if _G.AutoFarm and hum.Health > 0 then
                            local chest = ws.BoatStages.NormalStages.TheEnd.GoldenChest
                            if chest and chest:FindFirstChild("Trigger") then
                                local trigger = chest.Trigger
                                
                                local tween = ts:Create(hrp, TweenInfo.new((hrp.Position - trigger.Position).Magnitude / speed, Enum.EasingStyle.Linear), {CFrame = trigger.CFrame})
                                tween:Play()
                                tween.Completed:Wait()

                                for i = 1, 8 do
                                    firetouchinterest(hrp, trigger, 0)
                                    task.wait(0.03)
                                    firetouchinterest(hrp, trigger, 1)
                                    task.wait(0.03)
                                end

                                local timeout = 0
                                while hum and hum.Health > 0 and char.Parent and timeout < 5 do
                                    hrp.CFrame = trigger.CFrame
                                    firetouchinterest(hrp, trigger, 0)
                                    task.wait(0.05)
                                    firetouchinterest(hrp, trigger, 1)
                                    
                                    task.wait(0.2)
                                    timeout = timeout + 0.25
                                end

                                if hum and hum.Health > 0 then
                                    hum.Health = 0
                                end
                            end

                            bv:Destroy()
                            task.wait(2)

                            repeat task.wait(0.5) until lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") and lp.Character:FindFirstChildOfClass("Humanoid")
                            task.wait(1)
                        else
                            bv:Destroy()
                        end
                    end
                end
            end)
        end
    end
end)

local baseFlySpeed = 50
local speedMultiplier = 1
local isFlying = false
local upHolding = false
local downHolding = false

local flyConnection = nil
local bg, bv = nil, nil

local function stopFly()
    isFlying = false
    flyToggleBtn.Text = "OFF"
    flyToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)

    if flyConnection then flyConnection:Disconnect() flyConnection = nil end
    if bg then bg:Destroy() bg = nil end
    if bv then bv:Destroy() bv = nil end

    local char = lp.Character
    if char then
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        if hum then
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
        if char:FindFirstChild("Animate") then char.Animate.Disabled = false end
    end
end

local function startFly()
    local char = lp.Character
    if not char then return end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    if not hum or not root then return end

    isFlying = true
    flyToggleBtn.Text = "ON"
    flyToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 162, 255)

    if char:FindFirstChild("Animate") then char.Animate.Disabled = true end

    for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
        track:AdjustSpeed(0)
    end

    hum.PlatformStand = true

    bg = Instance.new("BodyGyro")
    bg.P = 9e4
    bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.cframe = root.CFrame
    bg.Parent = root

    bv = Instance.new("BodyVelocity")
    bv.velocity = Vector3.new(0, 0, 0)
    bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Parent = root

    flyConnection = rs.RenderStepped:Connect(function()
        if not isFlying or not char or not hum or hum.Health <= 0 then
            stopFly()
            return
        end

        local cam = ws.CurrentCamera
        bg.cframe = cam.CFrame

        local moveDir = hum.MoveDirection
        local finalVelocity = Vector3.new(0, 0, 0)

        if moveDir.Magnitude > 0 then
            local camCFrame = cam.CFrame
            local forwardAmount = moveDir:Dot(camCFrame.LookVector)
            local rightAmount = moveDir:Dot(camCFrame.RightVector)

            local flyVector = (camCFrame.LookVector * forwardAmount) + (camCFrame.RightVector * rightAmount)
            if flyVector.Magnitude > 0 then
                finalVelocity = flyVector.Unit * (baseFlySpeed * speedMultiplier)
            end
        end

        if upHolding then
            finalVelocity = finalVelocity + Vector3.new(0, baseFlySpeed * speedMultiplier, 0)
        elseif downHolding then
            finalVelocity = finalVelocity - Vector3.new(0, baseFlySpeed * speedMultiplier, 0)
        end

        bv.velocity = finalVelocity
    end)
end

