uis.JumpRequest:Connect(function()
    if _G.InfJumpToggle and lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") then
        lp.Character:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

noclipToggleBtn.MouseButton1Click:Connect(function()
    _G.NoclipToggle = not _G.NoclipToggle
    noclipToggleBtn.Text = _G.NoclipToggle and "ON" or "OFF"
    noclipToggleBtn.BackgroundColor3 = _G.NoclipToggle and Color3.fromRGB(0, 162, 255) or Color3.fromRGB(255, 255, 255)
end)

rs.Stepped:Connect(function()
    if lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") then
        local hum = lp.Character:FindFirstChildOfClass("Humanoid")
        if _G.WalkSpeedToggle then hum.WalkSpeed = _G.WalkSpeedVal end
        if _G.JumpPowerToggle then 
            hum.UseJumpPower = true
            hum.JumpPower = _G.JumpPowerVal 
        end
    end

    if _G.NoclipToggle and lp.Character then
        for _, part in pairs(lp.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

instantPromptToggleBtn.MouseButton1Click:Connect(function()
    _G.InstantPromptToggle = not _G.InstantPromptToggle
    instantPromptToggleBtn.Text = _G.InstantPromptToggle and "ON" or "OFF"
    instantPromptToggleBtn.BackgroundColor3 = _G.InstantPromptToggle and Color3.fromRGB(0, 162, 255) or Color3.fromRGB(255, 255, 255)
end)

pps.PromptButtonHoldBegan:Connect(function(prompt)
    if _G.InstantPromptToggle then
        fireproximityprompt(prompt)
    end
end)

