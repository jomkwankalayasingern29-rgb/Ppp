-- ฟังก์ชันรันโค้ด
local function runCode(times)
	local codeText = textBox.Text
	if codeText == "" then return end
	
	-- ใช้ loadstring เพื่อรัน Luau Script ที่พิมพ์ลงไป
	local func, err = loadstring(codeText)
	if func then
		pcall(function()
			for i = 1, times do
				func()
			end
		end)
	else
		warn("Code Error: " .. tostring(err))
	end
end

-- สร้างปุ่มกด (×1, ×10, ×100, ×1000, 10000)
local function createButton(name, text, posX, sizeX, color, callback)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Size = UDim2.new(sizeX, -3, 0, 26)
	btn.Position = UDim2.new(posX, 0, 0, 102)
	btn.BackgroundColor3 = color
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 12
	btn.Font = Enum.Font.SourceSansBold
	btn.Parent = frame
	
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 4)
	c.Parent = btn
	
	btn.MouseButton1Click:Connect(callback)
end

createButton("Btn1", "×1", 0, 0.33, Color3.fromRGB(14, 99, 156), function() runCode(1) end)
createButton("Btn10", "×10", 0.34, 0.33, Color3.fromRGB(14, 99, 156), function() runCode(10) end)
createButton("Btn100", "×100", 0.68, 0.32, Color3.fromRGB(14, 99, 156), function() runCode(100) end)
createButton("Btn1000", "×1000", 0.68, 0.32, Color3.fromRGB(14, 99, 156), function() runCode(1000) end)
