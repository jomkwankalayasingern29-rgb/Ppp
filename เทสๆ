    local dots = {"", ".", "..", "..."}
    local startTime = tick()
    while tick() - startTime < 2 do
        for _, d in ipairs(dots) do
            if not LoadText.Parent then return end
            LoadText.Text = "กำลังโหลด" .. d
            task.wait(0.3)
        end
