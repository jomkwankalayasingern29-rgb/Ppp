-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

-- ตั้งค่าตัวแปร
local dashEnabled = false
local dashPower = 50 -- ความแรงในการพุ่ง (ปรับมาก/น้อยได้ตามชอบ)
local cooldown = 0.3 -- ดีเลย์การพุ่ง (วินาที)
local lastDash = 0

-- สร้าง GUI ปุ่มเปิด-ปิด
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "DashGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

local toggleBtn = Instance.new("TextButton")
toggleBtn.Name = "ToggleDash"
toggleBtn.Size = UDim2.new(0, 160, 0, 50)
toggleBtn.Position = UDim2.new(0.5, -80, 0.85, 0)
toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleBtn.TextSize = 16
toggleBtn.Font = Enum.Font.SourceSansBold
toggleBtn.Text = "Dash Mode: OFF"
toggleBtn.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = toggleBtn

-- ฟังก์ชันกดเปิด-ปิด
toggleBtn.MouseButton1Click:Connect(function()
    dashEnabled = not dashEnabled
    if dashEnabled then
        toggleBtn.Text = "Dash Mode: ON"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        humanoid.WalkSpeed = 0 -- ล็อคความเร็วเดินปกติไม่ให้มันเดินแทรก
    else
        toggleBtn.Text = "Dash Mode: OFF"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        humanoid.WalkSpeed = 16 -- คืนค่าความเร็วเดิม
    end
end)

-- ระบบตรวจจับการเคลื่อนไหวและพุ่งตัว
RunService.RenderStepped:Connect(function()
    if not dashEnabled then return end
    
    local moveDir = humanoid.MoveDirection
    local currentTime = tick()
    
    -- ถ้าผู้เล่นกดปุ่มเดิน (MoveDirection มีค่ามากกว่า 0) และหมดเวลาคูลดาวน์
    if moveDir.Magnitude > 0 and (currentTime - lastDash) >= cooldown then
        lastDash = currentTime
        
        -- ดึงทิศทางกล้องปัจจุบัน
        local camera = workspace.CurrentCamera
        local camLook = camera.CFrame.LookVector
        local camRight = camera.CFrame.RightVector
        
        -- คำนวณทิศทางพุ่งตามมุมมองกล้องและปุ่มที่กด (W, A, S, D)
        -- แปลง MoveDirection ของ Humanoid ให้เข้ากับมุมมองกล้อง 3D
        local flatCamLook = Vector3.new(camLook.X, 0, camLook.Z).Unit
        local flatCamRight = Vector3.new(camRight.X, 0, camRight.Z).Unit
        
        -- เช็คปุ่มที่กดเทียบกับทิศทางกล้อง
        local dashVector = (flatCamLook * moveDir.Z + flatCamRight * moveDir.X).Unit
        
        -- สั่งพุ่งตัว (Velocity)
        humanoidRootPart.AssemblyLinearVelocity = Vector3.new(
            dashVector.X * dashPower,
            humanoidRootPart.AssemblyLinearVelocity.Y, -- รักษาระดับแรงโน้มถ่วงแนวตั้ง
            dashVector.Z * dashPower
        )
    end
end)

-- รองรับกรณีตัวละครตายแล้วเกิดใหม่
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoidRootPart = character:WaitForChild("HumanoidRootPart")
    humanoid = character:WaitForChild("Humanoid")
    if dashEnabled then
        humanoid.WalkSpeed = 0
    end
end)
