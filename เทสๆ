    btn.TextSize = 10
    btn.Parent = LeftSide

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = btn

    table.insert(categoryButtons, {Button = btn, Tab = targetTab})

    btn.MouseButton1Click:Connect(function()
        for _, cb in ipairs(categoryButtons) do
            cb.Tab.Visible = (cb.Tab == targetTab)
            cb.Button.BackgroundColor3 = (cb.Tab == targetTab) and Color3.fromRGB(0, 162, 255) or Color3.fromRGB(30, 30, 30)
            cb.Button.BackgroundTransparency = (cb.Tab == targetTab) and 0 or 0.5
            cb.Button.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
    end)
    return btn
end

