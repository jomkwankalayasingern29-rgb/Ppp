-- [ ระบบหมวดหมู่ด้านซ้าย (Category Buttons) ] --
local categoryButtons = {}
local function createCategoryButton(name, targetTab)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.95, 0, 0, 32)
    -- สีตอนยังไม่ถูกเลือก (สีเทาเข้มโปร่งใส คล้ายๆ ในภาพ)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    btn.BackgroundTransparency = 0.3
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.GothamBold
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 11
    btn.Parent = LeftSide

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    table.insert(categoryButtons, {Button = btn, Tab = targetTab})

    btn.MouseButton1Click:Connect(function()
        for _, cb in ipairs(categoryButtons) do
            cb.Tab.Visible = (cb.Tab == targetTab)
            if cb.Tab == targetTab then
                -- ปุ่มที่เลือก เป็นสีฟ้าสว่าง
                cb.Button.BackgroundColor3 = Color3.fromRGB(0, 162, 255)
                cb.Button.BackgroundTransparency = 0
            else
                -- ปุ่มปกติ
                cb.Button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                cb.Button.BackgroundTransparency = 0.3
            end
        end
    end)
    return btn
end

