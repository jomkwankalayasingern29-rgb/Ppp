local isFlinging = false
local originalPosition = nil
local connection = nil

-- ค้นหาผู้เล่นจากชื่อที่พิมพ์ (รองรับทั้งชื่อจริงและ Display Name)
local function getTarget(nameInput)
    if nameInput == "" then return nil end
    local lowerInput = string.lower(nameInput)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local playerName = string.lower(player.Name)
            local displayName = string.lower(player.DisplayName)
            if string.find(playerName, lowerInput) or string.find(displayName, lowerInput) then
                return player
            end
        end
    end
    return nil
end

-- ปุ่มกดเริ่ม/หยุด Fling
FlingButton.MouseButton1Click:Connect(function()
    if not isFlinging then
        -- กำลังจะเปิดการทำงาน ให้เช็คชื่อเป้าหมายก่อน
        local targetPlayer = getTarget(TextBox.Text)
        if not targetPlayer then
            FlingButton.Text = "ไม่พบผู้เล่นนี้!"
            task.wait(1)
            FlingButton.Text = "Status: OFF"
            return
        end
        
        if not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            FlingButton.Text = "เป้าหมายยังไม่เกิด!"
            task.wait(1)
            FlingButton.Text = "Status: OFF"
            return
        end
        
        -- บันทึกตำแหน่งเดิมก่อนวาร์ปไป
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            originalPosition = char.HumanoidRootPart.CFrame
        else
            return
        end
        
        isFlinging = true
        FlingButton.Text = "Target: " .. targetPlayer.Name
        FlingButton.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        
        -- เริ่มทำงานลูปหมุนตัวและวาร์ปจุ่ม
        connection = RunService.Stepped:Connect(function()
            if not _G.DeltaFlingRunning or not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then 
                return 
            end
            
            local myChar = LocalPlayer.Character
            local tChar = targetPlayer.Character
            
            if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                local myRoot = myChar.HumanoidRootPart
                local tRoot = tChar.HumanoidRootPart
                
                -- อัดความเร็วเพื่อให้เกิดแรงกระเด็น (Fling) และทับตำแหน่งเป้าหมาย
                myRoot.Velocity = Vector3.new(30000, 30000, 30000)
                myRoot.RotVelocity = Vector3.new(50000, 50000, 50000)
                myRoot.CFrame = tRoot.CFrame
            end
        end)
    else
        -- ปิดการทำงาน และวาร์ปกลับตำแหน่งเดิม
        isFlinging = false
        if connection then
            connection:Disconnect()
            connection = nil
        end
        
        FlingButton.Text = "Status: OFF"
        FlingButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        
        task.wait(0.05)
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") and originalPosition then
            myChar.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
            myChar.HumanoidRootPart.RotVelocity = Vector3.new(0, 0, 0)
            myChar.HumanoidRootPart.CFrame = originalPosition
        end
    end
end)

-- เคลียร์ระบบเมื่อรีเซ็ตตัวละคร
LocalPlayer.CharacterAdded:Connect(function()
    if isFlinging then
        isFlinging = false
        if connection then connection:Disconnect() end
        FlingButton.Text = "Status: OFF"
        FlingButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)
