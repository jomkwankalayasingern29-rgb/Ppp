local function copyToClipboard(text)
    pcall(function()
        if setclipboard then setclipboard(text) elseif toclipboard then toclipboard(text) end
    end)
end

local function loadSavedData()
    local success, result = pcall(function()
        if readfile and isfile and isfile(SaveFileName) then
            return HttpService:JSONDecode(readfile(SaveFileName))
        end
    end)
    if success and type(result) == "table" then
        return result
    end
    return {}
end

local function saveSavedData(data)
    pcall(function()
        if writefile then
            writefile(SaveFileName, HttpService:JSONEncode(data))
        end
    end)
end

