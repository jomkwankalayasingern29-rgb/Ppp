    btn.TextSize = 10
    btn.Parent = LeftSide

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 5)
    corner.Parent = btn

    table.insert(categoryButtons, {Button = btn, Tab = targetTab})

    btn.MouseButton1Click:Connect(function()
        for _, cb in ipairs(categoryButtons) do
            cb.Tab.Visible = (cb.Tab == targetTab)
            if cb.Tab == targetTab then
                cb.Button.BackgroundColor3 = Color3.fromRGB(0, 162, 255)
                cb.Button.BackgroundTransparency = 0
            else
                cb.Button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                cb.Button.BackgroundTransparency = 0.3
            end
        end
    end)
    return btn
end

