-- ระบบสลับเซิร์ฟคนน้อยเวอร์ชันใหม่ (ปลอดภัยและแม่นยำขึ้น)
HopBtn.MouseButton1Click:Connect(function()
    local textLabel, notifFrame = createNotificationUI()
    local HttpService = game:GetService("HttpService")
    local TeleportService = game:GetService("TeleportService")
    local Players = game:GetService("Players")
    
    textLabel.Text = "กำลังหา (1s)"
    
    task.spawn(function()
        local seconds = 1
        local searching = true
        
        -- ตัวนับเวลาแสดงผลบน UI
        task.spawn(function()
            while searching do
                task.wait(1)
                seconds = seconds + 1
                if searching then
                    textLabel.Text = "กำลังหา (" .. seconds .. "s)"
                end
            end
        end)
        
        -- ใช้ pcall ครอบการดึง API ป้องกันรันแล้วเออเร่อ
        local success, result = pcall(function()
            local url = string.format("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Asc&limit=100", tostring(game.PlaceId))
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        
        if success and result and result.data then
            local targetServerId = nil
            
            -- วนลูปหาเซิร์ฟเวอร์ที่มีคนเล่นน้อยที่สุด (0 หรือ 1 คน)
            for _, server in ipairs(result.data) do
                if server.id ~= game.JobId and type(server.playing) == "number" and server.playing <= 1 then
                    targetServerId = server.id
                    break
                end
            end
            
            -- ถ้าหาเซิร์ฟ 0-1 คนไม่ได้ ให้ยอมรับเซิร์ฟที่คนน้อยที่สุดที่มีอยู่ในรายการแทน
            if not targetServerId and #result.data > 0 then
                for _, server in ipairs(result.data) do
                    if server.id ~= game.JobId then
                        targetServerId = server.id
                        break
                    end
                end
            end
            
            if targetServerId then
                searching = false
                textLabel.Text = "เจอเซิร์ฟแล้วกำลังวาป"
                task.wait(0.5)
                notifFrame:Destroy()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServerId, Players.LocalPlayer)
                return
            end
        end
        
        -- เผื่อกรณีดึง API ไม่สำเร็จ ให้ใช้ระบบ Teleport สำรองของ Roblox ทันที
        searching = false
        textLabel.Text = "กำลังสุ่มเปลี่ยนเซิร์ฟ..."
        task.wait(0.5)
        notifFrame:Destroy()
        TeleportService:Teleport(game.PlaceId, Players.LocalPlayer)
    end)
end)

