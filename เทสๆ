    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local myRoot = char.HumanoidRootPart
        local closestTarget = nil
        local shortestDist = math.huge

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
                local targetRoot = player.Character.HumanoidRootPart
                local dist = (targetRoot.Position - myRoot.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestTarget = player.Character
                end
            end
        end

        if closestTarget and closestTarget:FindFirstChild("HumanoidRootPart") then
            local targetRoot = closestTarget.HumanoidRootPart
            myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3.5)
            showNotification("วาร์ปหาผู้เล่นใกล้ที่สุดสำเร็จ!", true)
