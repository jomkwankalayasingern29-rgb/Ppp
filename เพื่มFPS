-- ระบบกดปุ่มย่อ / ขยาย / ปิด
local isMinimized = false
local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

local function minimizeUI()
    if isMinimized or ConfirmOverlay.Visible then return end
    isMinimized = true
    local minimizeTween = TweenService:Create(MainFrame, tweenInfo, {Size = UDim2.new(0, 320, 0, 0), BackgroundTransparency = 1})
    minimizeTween:Play()
    minimizeTween.Completed:Connect(function()
        if isMinimized then
            MainFrame.Visible = false
            D_Icon.Visible = true
            D_Icon.Size = UDim2.new(0, 0, 0, 0)
            TweenService:Create(D_Icon, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 40, 0, 40)}):Play()
        end
    end)
end

local function maximizeUI()
    if not isMinimized then return end
    isMinimized = false
    D_Icon.Visible = false
    MainFrame.Visible = true
    MainFrame.BackgroundTransparency = 0
    TweenService:Create(MainFrame, tweenInfo, {Size = UDim2.new(0, 320, 0, 260)}):Play()
end

MinimizeBtn.MouseButton1Click:Connect(minimizeUI)
D_Icon.MouseButton1Click:Connect(maximizeUI)

CloseBtn.MouseButton1Click:Connect(function()
    if not isMinimized then
        ConfirmOverlay.Visible = true
    end
end)

