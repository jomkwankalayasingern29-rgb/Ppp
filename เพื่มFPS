-- 1. ภาพดินน้ำมัน (Plastic Graphics)
local originalMaterials = {}
createToggle("ClayToggle", "ภาพดินน้ำมัน (ลดภาระการประมวลผล)", function(state)
    if state then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and not obj:IsDescendantOf(Players) then
                if not originalMaterials[obj] then
                    originalMaterials[obj] = obj.Material
                end
                pcall(function()
                    obj.Material = Enum.Material.SmoothPlastic
                    obj.Reflectance = 0
                end)
            end
        end
    else
        for obj, mat in pairs(originalMaterials) do
            if obj and obj.Parent then
                pcall(function() obj.Material = mat end)
            end
        end
        originalMaterials = {}
    end
end)

-- 2. แก้แลคเฉพาะจุด (Selective FPS Boost)
local optimizedParts = {}
createToggle("SelectiveFpsToggle", "แก้แลคเฉพาะจุด (ซ่อนหิน/ใบไม้/ฝุ่น)", function(state)
    if state then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and not obj:IsDescendantOf(Players) then
                local nameLower = string.lower(obj.Name)
                if string.find(nameLower, "debris") or string.find(nameLower, "rock") or string.find(nameLower, "stone") or string.find(nameLower, "grass") or string.find(nameLower, "leaf") or string.find(nameLower, "particle") then
                    if not optimizedParts[obj] then
                        optimizedParts[obj] = {CanCollide = obj.CanCollide, Transparency = obj.Transparency, CastShadow = obj.CastShadow}
                    end
                    pcall(function()
                        obj.CanCollide = false
                        obj.CastShadow = false
                        obj.Transparency = 1
                    end)
                end
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
                pcall(function() obj.Enabled = false end)
            end
        end
    else
        for obj, data in pairs(optimizedParts) do
            if obj and obj.Parent then
                pcall(function()
                    obj.CanCollide = data.CanCollide
                    obj.Transparency = data.Transparency
                    obj.CastShadow = data.CastShadow
                end)
            end
        end
        optimizedParts = {}
    end
end)

-- 3. ลบเอฟเฟคและควันทั้งหมด (FPS Boost)
local effectConnection = nil
local function clearEffects(parentObj)
    for _, obj in ipairs(parentObj:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Explosion") or obj:IsA("Beam") or obj:IsA("Trail") then
            pcall(function() obj:Destroy() end)
        end
    end
end

createToggle("FpsBoostToggle", "ลบเอฟเฟคทั้งหมด / ควัน / ละออง", function(state)
    if state then
        clearEffects(Workspace)
        clearEffects(Lighting)
        effectConnection = Workspace.DescendantAdded:Connect(function(obj)
            if obj:IsA("ParticleEmitter") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Explosion") or obj:IsA("Beam") or obj:IsA("Trail") then
                task.spawn(function() pcall(function() obj:Destroy() end) end)
            end
        end)
    else
        if effectConnection then
            effectConnection:Disconnect()
            effectConnection = nil
        end
    end
end)

-- 4. ลบสิ่งที่ไม่จำเป็น (หิน/เศษเอฟเฟคการโจมตี)
local junkConnection = nil
local function isJunkPart(obj)
    if obj:IsA("BasePart") then
        local nameLower = string.lower(obj.Name)
        if string.find(nameLower, "rock") or string.find(nameLower, "stone") or string.find(nameLower, "debris") or string.find(nameLower, "fx") or string.find(nameLower, "impact") or string.find(nameLower, "dust") or string.find(nameLower, "hit") then
            if not obj:IsDescendantOf(Players) and obj.Parent ~= Workspace then
                return true
            end
        end
    end
    return false
end

createToggle("RemoveJunkToggle", "ลบหิน / เศษซาก / เอฟเฟคตี", function(state)
    if state then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if isJunkPart(obj) then pcall(function() obj:Destroy() end) end
        end
        junkConnection = Workspace.DescendantAdded:Connect(function(obj)
            if isJunkPart(obj) then
                task.spawn(function()
                    task.wait(0.05)
                    pcall(function() obj:Destroy() end)
                end)
            end
        end)
    else
        if junkConnection then
            junkConnection:Disconnect()
            junkConnection = nil
        end
    end
end)
