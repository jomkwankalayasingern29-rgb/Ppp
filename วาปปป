-- =============================================================================
-- ฟังก์ชันใหม่: "วาร์ปเก็บไอเทม" (กรองร้านค้าออก และเจาะจงเฉพาะ Token Mushroom)
-- =============================================================================
createToggleRow(AutoContainer, "วาร์ปเก็บไอเทม", function(state)
    activeFunctions.autoFarm = state
    if state then
        autoFarmCoroutine = task.spawn(function()
            while activeFunctions.autoFarm do
                task.wait(0.2)
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local hrp = character.HumanoidRootPart
                    local targetPosition = nil
                    local targetProximity = nil
                    
                    local shortestDist = math.huge
                    
                    for _, desc in ipairs(Workspace:GetDescendants()) do
                        if desc:IsA("ProximityPrompt") and desc.Enabled then
                            local parentObj = desc.Parent
                            if parentObj then
                                local objectText = string.lower(desc.ObjectText or "")
                                local parentName = string.lower(parentObj.Name or "")
                                local actionText = string.lower(desc.ActionText or "")
                                
                                -- เช็คว่าเป็น Token Mushroom จริงๆ
                                local isTokenMushroom = string.find(objectText, "token mushroom") or string.find(parentName, "token mushroom")
                                
                                -- เช็คคำต้องห้าม (ป้องการเผลอไปร้านค้า, เมนูซื้อของ, ฯลฯ)
                                local isShopOrMenu = string.find(parentName, "shop") or string.find(parentName, "store") or string.find(parentName, "sell") or string.find(parentName, "event") or string.find(parentName, "seeds") or string.find(objectText, "buy") or string.find(objectText, "sell")
                                
                                if isTokenMushroom and not isShopOrMenu then
                                    local partPos = parentObj:IsA("BasePart") and parentObj.Position or parentObj:GetPivot().Position
                                    local dist = (hrp.Position - partPos).Magnitude
                                    if dist < shortestDist then
                                        shortestDist = dist
                                        targetProximity = desc
                                        targetPosition = partPos
                                    end
                                end
                            end
                        end
                    end
                    
                    -- วาร์ปเฉพาะเมื่อเจอเห็ดจริงๆ เท่านั้น ถ้านอกเหนือจากนี้ตัวละครจะยืนเฉยๆ
                    if targetPosition and targetProximity then
                        hrp.CFrame = CFrame.new(targetPosition + Vector3.new(0, 3, 0))
                        task.wait(0.15)
                        pcall(function()
                            fireproximityprompt(targetProximity)
                        end)
                    end
                end
            end
        end)
    else
        if autoFarmCoroutine then
            task.cancel(autoFarmCoroutine)
            autoFarmCoroutine = nil
        end
    end
end)
