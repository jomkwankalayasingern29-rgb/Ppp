-- =============================================================================
-- Precise Auto-Teleport Collection Feature for Token Mushroom (Filtered)
-- =============================================================================
createToggleRow(AutoContainer, "วาร์ปเก็บไอเทม", function(state)
    activeFunctions.autoFarm = state
    if state then
        autoFarmCoroutine = task.spawn(function()
            while activeFunctions.autoFarm do
                task.wait(0.15)
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local hrp = character.HumanoidRootPart
                    local targetPosition = nil
                    local targetPrompt = nil

                    -- Search specifically for ProximityPrompts belonging to Token Mushrooms
                    for _, prompt in ipairs(Workspace:GetDescendants()) do
                        if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                            local parent = prompt.Parent
                            if parent then
                                local parentName = string.lower(parent.Name)
                                local objectText = string.lower(prompt.ObjectText or "")

                                if not string.find(parentName, "shop") and not string.find(objectText, "shop") and
                                   not string.find(parentName, "ค้นหา") and not string.find(objectText, "ค้นหา") then
                                    
                                    if string.find(parentName, "mushroom") or string.find(parentName, "token") or string.find(objectText, "token mushroom") then
                                        local pos = parent:IsA("BasePart") and parent.Position or (parent:IsA("Model") and parent:GetPivot().Position)
                                        if pos then
                                            targetPosition = pos
                                            targetPrompt = prompt
                                            break
                                        end
                                    end
                                end
                            end
                        end
                    end

                    if targetPosition and targetPrompt then
                        hrp.CFrame = CFrame.new(targetPosition + Vector3.new(0, 2, 0))
                        task.wait(0.08)
                        pcall(function()
                            if fireproximityprompt then
                                fireproximityprompt(targetPrompt)
                            else
                                fireproximityprompt(targetPrompt)
                            end
                        end)
                    end
                end
            end
        end)
    else
        if autoFarmCoroutine then
            task.cancel(autoFarmCoroutine)
            autoFarmCoroutine = nil
        end
    end
end)

-- Switch tab utility
local function switchTab(tabName)
    for name, container in pairs(FunctionContainers) do
        container.Visible = (name == tabName)
    end
end

