-- =============================================================================
-- ฟังก์ชันใหม่: "วาร์ปเก็บไอเทม" (เช็คเฉพาะ ProximityPrompt ที่เป็น Token Mushroom เท่านั้น)
-- =============================================================================
createToggleRow(AutoContainer, "วาร์ปเก็บไอเทม", function(state)
    activeFunctions.autoFarm = state
    if state then
        autoFarmCoroutine = task.spawn(function()
            while activeFunctions.autoFarm do
                task.wait(0.2)
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local hrp = character.HumanoidRootPart
                    local targetPosition = nil
                    local targetProximity = nil
                    
                    local shortestDist = math.huge
                    
                    -- วนลูปหาเฉพาะ ProximityPrompt ที่ Object Text หรือ Parent มีคำว่า Token Mushroom จริงๆ
                    for _, desc in ipairs(Workspace:GetDescendants()) do
                        if desc:IsA("ProximityPrompt") and desc.Enabled then
                            local parentObj = desc.Parent
                            if parentObj then
                                local objectText = string.lower(desc.ObjectText or "")
                                local parentName = string.lower(parentObj.Name or "")
                                
                                -- เช็คเฉพาะชื่อ Token Mushroom หรือคำที่เกี่ยวข้องกับเห็ดนี้โดยตรง ห้ามมีคำว่าร้านค้าหรือปุ่มอื่นปะปน
                                if string.find(objectText, "token mushroom") or string.find(parentName, "token mushroom") then
                                    local partPos = parentObj:IsA("BasePart") and parentObj.Position or parentObj:GetPivot().Position
                                    local dist = (hrp.Position - partPos).Magnitude
                                    if dist < shortestDist then
                                        shortestDist = dist
                                        targetProximity = desc
                                        targetPosition = partPos
                                    end
                                end
                            end
                        end
                    end
                    
                    -- ถ้าเจอเฉพาะเจาะจงถึงจะวาร์ปไป ถ้าไม่เจอจะยืนเฉยๆ
                    if targetPosition and targetProximity then
                        hrp.CFrame = CFrame.new(targetPosition + Vector3.new(0, 3, 0))
                        task.wait(0.15)
                        pcall(function()
                            fireproximityprompt(targetProximity)
                        end)
                    end
                end
            end
        end)
    else
        if autoFarmCoroutine then
            task.cancel(autoFarmCoroutine)
            autoFarmCoroutine = nil
        end
    end
end)
