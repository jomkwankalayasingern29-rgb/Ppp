-- 2. เก็บผลไม้อัตโนมัติ (เช็คสถานะล็อก และ กรองน้ำหนักไม่ให้เกินที่กำหนด)
createToggle("เก็บผลไม้อัตโนมัติ", function(state)
    activeFunctions.autoHarvestFruit = state
    task.spawn(function()
        while activeFunctions.autoHarvestFruit do
            task.wait(0.15)
            pcall(function()
                for _, prompt in ipairs(Workspace:GetDescendants()) do
                    if not activeFunctions.autoHarvestFruit then break end
                    if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                        local objText = prompt.ObjectText or ""
                        local actText = prompt.ActionText or ""
                        local parent = prompt.Parent

                        if string.find(string.lower(objText), "เก็บเกี่ยว") or string.find(string.lower(actText), "เก็บเกี่ยว") or 
                           string.find(string.lower(objText), "harvest") or string.find(string.lower(actText), "harvest") then
                            
                            local shouldCollect = false
                            
                            if parent then
                                -- เช็คการล็อก (Locked)
                                local isLocked = parent:GetAttribute("Locked") or parent:GetAttribute("IsLocked")
                                if not isLocked and parent.Parent then
                                    isLocked = parent.Parent:GetAttribute("Locked") or parent.Parent:GetAttribute("IsLocked")
                                end

                                if not isLocked then
                                    local fullText = objText .. " " .. parent.Name
                                    local weightFound = nil

                                    -- หาตัวเลขที่มีคำว่า kg ตามหลัง
                                    for numStr in string.gmatch(fullText, "(%d+%.?%d*)%s*kg") do
                                        weightFound = tonumber(numStr)
                                        break
                                    end

                                    -- ถ้าไม่เจอ หาตัวเลขใน []
                                    if not weightFound then
                                        for numStr in string.gmatch(fullText, "%[(%d+%.?%d*)%]") do
                                            local val = tonumber(numStr)
                                            if val and val < 10000 then
                                                weightFound = val
                                                break
                                            end
                                        end
                                    end

                                    -- เงื่อนไข: ต้องเจอน้ำหนัก และ น้ำหนัก < maxFruitWeight เท่านั้นถึงจะเก็บ
                                    if weightFound and weightFound < maxFruitWeight then
                                        shouldCollect = true
                                    end
                                end
                            end

                            if shouldCollect then
                                if fireproximityprompt then fireproximityprompt(prompt) end
                            end
                        end
                    end
                end
            end)
        end
    end)
end)

