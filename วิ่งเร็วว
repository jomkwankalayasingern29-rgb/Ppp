local Players = game:GetService("Players")
local player = Players.LocalPlayer

if player.PlayerGui:FindFirstChild("GKHubSpeed") then
    player.PlayerGui.GKHubSpeed:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "GKHubSpeed"
ScreenGui.Parent = player.PlayerGui

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 180, 0, 110)
MainFrame.Position = UDim2.new(0.5, -90, 0.5, -55)
MainFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 6)
UICorner.Parent = MainFrame

local Header = Instance.new("Frame")
Header.Size = UDim2.new(1, 0, 0, 26)
Header.BackgroundColor3 = Color3.fromRGB(0, 110, 255)
Header.BorderSizePixel = 0
Header.Parent = MainFrame

local HeaderCorner = Instance.new("UICorner")
HeaderCorner.CornerRadius = UDim.new(0, 6)
HeaderCorner.Parent = Header

local HeaderCover = Instance.new("Frame")
HeaderCover.Size = UDim2.new(1, 0, 0, 6)
HeaderCover.Position = UDim2.new(0, 0, 1, -6)
HeaderCover.BackgroundColor3 = Color3.fromRGB(0, 110, 255)
HeaderCover.BorderSizePixel = 0
HeaderCover.Parent = Header

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 1, 0)
Title.BackgroundTransparency = 1
Title.Text = "GKHub - Speed"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 13
Title.Font = Enum.Font.GothamBold
Title.Parent = Header

local TextBox = Instance.new("TextBox")
TextBox.Size = UDim2.new(0.85, 0, 0, 32)
TextBox.Position = UDim2.new(0.075, 0, 0, 36)
TextBox.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
TextBox.TextColor3 = Color3.fromRGB(255, 255, 255)
TextBox.PlaceholderText = "ใส่ตัวเลขความเร็ว..."
TextBox.PlaceholderColor3 = Color3.fromRGB(120, 120, 140)
TextBox.Text = ""
TextBox.TextSize = 12
TextBox.Font = Enum.Font.Gotham
TextBox.ClearTextOnFocus = false
TextBox.BorderSizePixel = 0
TextBox.Parent = MainFrame

local BoxCorner = Instance.new("UICorner")
BoxCorner.CornerRadius = UDim.new(0, 4)
BoxCorner.Parent = TextBox

local ToggleButton = Instance.new("TextButton")
ToggleButton.Size = UDim2.new(0.85, 0, 0, 28)
ToggleButton.Position = UDim2.new(0.075, 0, 0, 74)
ToggleButton.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
ToggleButton.TextColor3 = Color3.fromRGB(200, 200, 200)
ToggleButton.Text = "Status: OFF"
ToggleButton.TextSize = 12
ToggleButton.Font = Enum.Font.GothamBold
ToggleButton.BorderSizePixel = 0
ToggleButton.Parent = MainFrame

local BtnCorner = Instance.new("UICorner")
BtnCorner.CornerRadius = UDim.new(0, 4)
BtnCorner.Parent = ToggleButton

local isEnabled = false
local defaultWalkSpeed = 16

-- เก็บค่าความเร็วปกติเมื่อตัวละครเกิดใหม่
player.CharacterAdded:Connect(function(char)
    local humanoid = char:WaitForChild("Humanoid")
    defaultWalkSpeed = humanoid.WalkSpeed
    if isEnabled then
        local speedValue = tonumber(TextBox.Text)
        if speedValue then
            humanoid.WalkSpeed = speedValue
        end
    end
end)

ToggleButton.MouseButton1Click:Connect(function()
    isEnabled = not isEnabled
    local char = player.Character
    if char and char:FindFirstChild("Humanoid") then
        local humanoid = char.Humanoid
        if isEnabled then
            local speedValue = tonumber(TextBox.Text)
            if speedValue then
                humanoid.WalkSpeed = speedValue
                ToggleButton.Text = "Status: ON"
                ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 110, 255)
                ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                isEnabled = false
                TextBox.PlaceholderText = "กรุณาใส่ตัวเลขก่อน!"
            end
        else
            humanoid.WalkSpeed = defaultWalkSpeed
            ToggleButton.Text = "Status: OFF"
            ToggleButton.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
            ToggleButton.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
    end
end)
