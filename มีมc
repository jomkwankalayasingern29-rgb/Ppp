-- ลูปฟาร์ม 1-25
task.spawn(function()
    while true do
        task.wait(0.2)
        if masterFarmLevelEnabled then
            pcall(function()
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") or char.Humanoid.Health <= 0 then return end
                local hrp = char.HumanoidRootPart
                
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end

                local backpack = LocalPlayer:FindFirstChild("Backpack")
                if backpack then
                    for _, item in ipairs(backpack:GetChildren()) do
                        if item:IsA("Tool") then char.Humanoid:EquipTool(item) break end
                    end
                end

                local questPart = FindObject(Workspace, "Floppa Quest 1") or FindObject(Workspace, "Main Quest")
                if questPart and (hrp.Position - questPart.Position).Magnitude > 25 then
                    FlyTo(questPart.CFrame + Vector3.new(0, 3, 0), function() return masterFarmLevelEnabled end)
                    task.wait(0.3)
                end

                for _, v in pairs(Workspace:GetDescendants()) do
                    if v:IsA("ProximityPrompt") and (v.Parent.Position - hrp.Position).Magnitude < 25 then
                        fireproximityprompt(v)
                    end
                end

                local monsterPart = FindNearestMonster("Floppa")
                if monsterPart then
                    FlyTo(monsterPart.CFrame * CFrame.new(0, 3, 4), function() return masterFarmLevelEnabled end)
                    while masterFarmLevelEnabled and monsterPart and monsterPart.Parent and monsterPart.Parent:FindFirstChild("Humanoid") and monsterPart.Parent.Humanoid.Health > 0 do
                        local curChar = LocalPlayer.Character
                        if not curChar or not curChar:FindFirstChild("HumanoidRootPart") then break end
                        curChar.HumanoidRootPart.CFrame = monsterPart.CFrame * CFrame.new(0, 3, 4)
                        local tool = curChar:FindFirstChildOfClass("Tool")
                        if tool then tool:Activate() end
                        task.wait(0.15)
                    end
                end
            end)
        end
    end
end)

