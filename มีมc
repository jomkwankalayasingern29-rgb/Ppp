local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

local Window = Rayfield:CreateWindow({
   Name = "Meme Sea | Auto Farm Level (Delta)",
   LoadingTitle = "กำลังโหลดระบบออโต้ฟาร์ม...",
   LoadingSubtitle = "by Developer",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false,
})

local MainTab = Window:CreateTab("ฟาร์มเลเวล", "home")
local PlayerTab = Window:CreateTab("ตัวละคร", "user")

local masterFarmLevelEnabled = false

-- ฟังก์ชันตั้งค่าความเป็นอมตะ (999M)
local function ApplyGodMode(char)
    pcall(function()
        local hum = char:WaitForChild("Humanoid", 3)
        if hum then
            hum.MaxHealth = 999999999
            hum.Health = 999999999
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        end
    end)
end

-- ฟังก์ชันบินด้วย Tween แบบปลอดภัยสำหรับ Delta
local function FlyToTarget(targetCFrame)
    pcall(function()
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local hrp = char.HumanoidRootPart
        local distance = (hrp.Position - targetCFrame.Position).Magnitude
        local speed = 200
        local timeTake = distance / speed
        if timeTake < 0.1 then timeTake = 0.1 end
        
        local tweenInfo = TweenInfo.new(timeTake, Enum.EasingStyle.Linear)
        local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
        tween:Play()
        
        local completed = false
        local connection
        connection = tween.Completed:Connect(function()
            completed = true
            if connection then connection:Disconnect() end
        end)
        
        while not completed and masterFarmLevelEnabled do
            task.wait(0.1)
        end
        if not masterFarmLevelEnabled then
            tween:Cancel()
        end
    end)
end

MainTab:CreateToggle({
   Name = "ออโต้ฟาร์มเลเวล (เควส + ตีออโต้)",
   CurrentValue = false,
   Flag = "AutoFarmLevelMaster",
   Callback = function(Value)
      masterFarmLevelEnabled = Value
      
      local char = LocalPlayer.Character
      if char and char:FindFirstChild("Humanoid") then
          local hum = char.Humanoid
          if Value then
              hum.MaxHealth = 999999999
              hum.Health = 999999999
              hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
          else
              hum.MaxHealth = 100
              hum.Health = 100
              hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
          end
      end

      Rayfield:Notify({
         Title = "สถานะออโต้ฟาร์ม",
         Content = Value and "เปิดใช้งานระบบออโต้ฟาร์มแล้ว" | "ปิดการทำงานแล้ว",
         Duration = 2,
      })
   end,
})

-- รองรับตัวละครเกิดใหม่ (ให้อมตะทำงานต่ออัตโนมัติ)
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(1.5)
    if masterFarmLevelEnabled then
        ApplyGodMode(char)
    end
end)

-- ลูปหลักออโต้ฟาร์ม (ความเร็ว 0.5 วินาที)
task.spawn(function()
    while task.wait(0.5) do
        if masterFarmLevelEnabled then
            pcall(function()
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
                local hrp = char.HumanoidRootPart
                local humanoid = char.Humanoid

                -- ล็อคเลือด 999M ตลอดเวลา
                if humanoid.MaxHealth ~= 999999999 then
                    humanoid.MaxHealth = 999999999
                end
                if humanoid.Health < humanoid.MaxHealth then
                    humanoid.Health = humanoid.MaxHealth
                end

                -- ดึงเลเวลผู้เล่น
                local playerLevel = 1
                local dataFolder = LocalPlayer:FindFirstChild("Data")
                if dataFolder and dataFolder:FindFirstChild("Level") then
                    playerLevel = dataFolder.Level.Value
                end

                -- กำหนดเควสและมอนสเตอร์
                local questName = "Floppa Quest 1"
                local monsterName = "Floppa"

                if playerLevel >= 15 and playerLevel < 30 then
                    questName = "Floppa Quest 2"
                    monsterName = "Floppa"
                elseif playerLevel >= 30 then
                    questName = "Floppa Quest 3"
                    monsterName = "Floppa"
                end

                -- ระบบรับเควส (ปลอดภัยต่อ Delta)
                local questPart = Workspace:FindFirstChild(questName, true)
                if questPart and questPart:IsA("BasePart") then
                    FlyToTarget(questPart.CFrame + Vector3.new(0, 3, 0))
                    task.wait(0.3)
                    for _, v in pairs(Workspace:GetDescendants()) do
                        if v:IsA("ProximityPrompt") and v.Parent and (v.Parent.Position - hrp.Position).Magnitude < 15 then
                            if fireproximityprompt then
                                fireproximityprompt(v)
                            end
                        end
                    end
                end

                -- ค้นหาและโจมตีมอนสเตอร์
                local targetMonster = nil
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj.Name == monsterName then
                        local enemyHum = obj:FindFirstChildOfClass("Humanoid")
                        local rootPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
                        if enemyHum and rootPart and enemyHum.Health > 0 then
                            targetMonster = rootPart
                            break
                        end
                    end
                end

                if targetMonster then
                    FlyToTarget(targetMonster.CFrame * CFrame.new(0, 4, 3))
                    
                    while masterFarmLevelEnabled and targetMonster and targetMonster.Parent and targetMonster.Parent:FindFirstChild("Humanoid") and targetMonster.Parent.Humanoid.Health > 0 do
                        hrp.CFrame = targetMonster.CFrame * CFrame.new(0, 4, 3)
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        
                        -- ถืออาวุธช่องแรกและโจมตี
                        local backpack = LocalPlayer:FindFirstChild("Backpack")
                        if backpack then
                            local slot1Item = backpack:FindFirstChildOfClass("Tool")
                            local currentTool = char:FindFirstChildOfClass("Tool")
                            if slot1Item and currentTool ~= slot1Item then
                                humanoid:EquipTool(slot1Item)
                            end
                        end

                        local tool = char:FindFirstChildOfClass("Tool")
                        if tool then
                            pcall(function() tool:Activate() end)
                        end
                        task.wait(0.2)
                    end
                end
            end)
        end
    end
end)

