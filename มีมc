-- ==================== ระบบออโต้ฟาร์มเลเวล (รวมรับเควส + ตีมอน + อมตะ 999M) ====================
local masterFarmLevelEnabled = false

-- ฟังก์ชันตั้งค่าความเป็นอมตะ
local function ApplyGodMode(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then
        hum.MaxHealth = 999999999
        hum.Health = 999999999
        hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
    end
end

-- ฟังก์ชันเสริมสำหรับบินด้วย Tween
local function FlyToTarget(targetCFrame)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = LocalPlayer.Character.HumanoidRootPart
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = 250
    local timeTake = distance / speed
    if timeTake < 0.1 then timeTake = 0.1 end
    
    local tweenInfo = TweenInfo.new(timeTake, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    
    local completed = false
    local connection
    connection = tween.Completed:Connect(function()
        completed = true
        connection:Disconnect()
    end)
    
    while not completed and masterFarmLevelEnabled do
        task.wait()
    end
    if not masterFarmLevelEnabled then
        tween:Cancel()
    end
end

-- ฟังก์ชันค้นหาวัตถุใน Workspace
local function FindObject(parent, name)
    if not parent then return nil end
    for _, v in pairs(parent:GetDescendants()) do
        if v.Name == name then
            if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") then
                return v.HumanoidRootPart
            elseif v:IsA("BasePart") then
                return v
            end
        end
    end
    return nil
end

MainTab:CreateToggle({
   Name = "ออโต้ฟาร์มเลเวล (เควส + ตีออโต้)",
   CurrentValue = false,
   Flag = "AutoFarmLevelMaster",
   Callback = function(Value)
      masterFarmLevelEnabled = Value
      
      local char = LocalPlayer.Character
      if char and char:FindFirstChild("Humanoid") then
          local hum = char.Humanoid
          if Value then
              hum.MaxHealth = 999999999
              hum.Health = 999999999
              hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
          else
              hum.MaxHealth = 100
              hum.Health = 100
              hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
          end
      end

      Rayfield:Notify({
         Title = "สถานะออโต้ฟาร์มเลเวล",
         Content = Value and "เปิดใช้งานออโต้ฟาร์ม (รับเควส/ตีมอน/อมตะ 999M) แล้ว" or "ปิดการทำงานทั้งหมดแล้ว",
         Duration = 2,
      })
   end,
})

-- รองรับเมื่อตัวละครตายและเกิดใหม่ ให้เปิดอมตะต่อเนื่องทันที
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(1)
    if masterFarmLevelEnabled then
        ApplyGodMode(char)
    end
end)

-- ลูปหลักทำงานระบบฟาร์มทั้งหมด (ความเร็ว 0.5 วินาที)
task.spawn(function()
    while task.wait(0.5) do
        if masterFarmLevelEnabled then
            pcall(function()
                local playerLevel = 1
                if LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Level") then
                    playerLevel = LocalPlayer.Data.Level.Value
                end

                -- กำหนดเควสและชื่อมอนสเตอร์ตามเลเวล
                local questName = "Floppa Quest 1"
                local monsterName = "Floppa"

                if playerLevel >= 15 and playerLevel < 30 then
                    questName = "Floppa Quest 2"
                    monsterName = "Floppa"
                elseif playerLevel >= 30 then
                    questName = "Floppa Quest 3"
                    monsterName = "Floppa"
                end

                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
                local hrp = char.HumanoidRootPart
                local humanoid = char.Humanoid

                -- 1. ล็อคเลือดอมตะ 999M & รีเลือดให้เต็มตลอดเวลา & ปิดการชน
                if humanoid.MaxHealth ~= 999999999 then
                    humanoid.MaxHealth = 999999999
                end
                if humanoid.Health < humanoid.MaxHealth then
                    humanoid.Health = humanoid.MaxHealth
                end
                
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end

                -- 2. ระบบรับเควส (ตรวจสอบว่ามีเควสอยู่ไหม ถ้ายังให้บินไปรับ)
                local questPart = FindObject(Workspace, questName)
                if questPart then
                    FlyToTarget(questPart.CFrame + Vector3.new(0, 3, 0))
                    task.wait(0.3)
                    for _, v in pairs(Workspace:GetDescendants()) do
                        if v:IsA("ProximityPrompt") and (v.Parent.Position - hrp.Position).Magnitude < 15 then
                            fireproximityprompt(v)
                        end
                    end
                end

                -- 3. ค้นหาและตีมอนสเตอร์วนไปจนกว่าจะตายครบ (หรือหาตัวใหม่)
                local targetMonster = nil
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj ~= char.Parent and obj.Name == monsterName then
                        local enemyHum = obj:FindFirstChildOfClass("Humanoid")
                        local rootPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
                        if enemyHum and rootPart and enemyHum.Health > 0 then
                            targetMonster = rootPart
                            break
                        end
                    end
                end

                if targetMonster then
                    FlyToTarget(targetMonster.CFrame * CFrame.new(0, 4, 3))
                    
                    while masterFarmLevelEnabled and targetMonster and targetMonster.Parent and targetMonster.Parent:FindFirstChild("Humanoid") and targetMonster.Parent.Humanoid.Health > 0 do
                        hrp.CFrame = targetMonster.CFrame * CFrame.new(0, 4, 3)
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        
                        -- บังคับถือไอเท็มช่องที่ 1 และกดโจมตี
                        local backpack = LocalPlayer:FindFirstChild("Backpack")
                        if backpack then
                            local slot1Item = backpack:FindFirstChildOfClass("Tool")
                            local currentTool = char:FindFirstChildOfClass("Tool")
                            if slot1Item and currentTool ~= slot1Item then
                                humanoid:EquipTool(slot1Item)
                            end
                        end

                        local tool = char:FindFirstChildOfClass("Tool")
                        if tool then
                            tool:Activate()
                        end
                        task.wait(0.2)
                    end
                end
            end)
        end
    end
end)

