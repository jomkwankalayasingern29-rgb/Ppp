local function FlyTo(targetCFrame, isEnabledCheck)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = LocalPlayer.Character.HumanoidRootPart
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    if distance < 5 then return end
    local speed = 350
    local timeTake = distance / speed
    
    local tweenInfo = TweenInfo.new(timeTake, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    
    local completed = false
    local connection
    connection = tween.Completed:Connect(function()
        completed = true
        connection:Disconnect()
    end)
    
    while not completed and isEnabledCheck() do
        task.wait()
    end
    if not isEnabledCheck() then
        tween:Cancel()
    end
end

local function FindObject(parent, name)
    if not parent then return nil end
    for _, v in pairs(parent:GetDescendants()) do
        if v.Name == name then
            if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") then
                return v.HumanoidRootPart
            elseif v:IsA("BasePart") then
                return v
            end
        end
    end
    return nil
end

local function FindNearestMonster(monsterName, isEnabledCheck)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = char.HumanoidRootPart
    
    local nearest = nil
    local shortestDistance = math.huge
    
    for _, v in pairs(Workspace:GetDescendants()) do
        if isEnabledCheck() and v:IsA("Model") and v.Name == monsterName then
            local hum = v:FindFirstChildOfClass("Humanoid")
            local root = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Head")
            if hum and root and hum.Health > 0 then
                local dist = (hrp.Position - root.Position).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    nearest = root
                end
            end
        end
    end
    return nearest
end

local function SetupGodMode(char)
    local hum = char:WaitForChild("Humanoid")
    hum.MaxHealth = math.huge
    hum.Health = math.huge
    hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)

    hum.HealthChanged:Connect(function()
        if hum.Health < hum.MaxHealth then
            hum.Health = hum.MaxHealth
        end
    end)
end

