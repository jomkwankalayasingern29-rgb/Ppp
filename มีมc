local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

local Window = Rayfield:CreateWindow({
   Name = "Meme Sea | Auto Farm Level",
   LoadingTitle = "กำลังโหลดระบบออโต้ฟาร์ม...",
   LoadingSubtitle = "by Developer",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false,
})

local MainTab = Window:CreateTab("ฟาร์มเลเวล", "home")
local PlayerTab = Window:CreateTab("ตัวละคร", "user")

-- ==================== ระบบออโต้ฟาร์มเลเวล (รวมเควส + ตีมอน + อมตะ) ====================
local masterFarmLevelEnabled = false

-- ฟังก์ชันเคลื่อนที่แบบ Tween (บินไปรับเควส/หาฟลอปป้า)
local function FlyTo(targetCFrame)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = LocalPlayer.Character.HumanoidRootPart
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = 300
    local timeTake = distance / speed
    
    local tweenInfo = TweenInfo.new(timeTake, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    
    local completed = false
    local connection
    connection = tween.Completed:Connect(function()
        completed = true
        connection:Disconnect()
    end)
    
    while not completed and masterFarmLevelEnabled do
        task.wait()
    end
    if not masterFarmLevelEnabled then
        tween:Cancel()
    end
end

-- ฟังก์ชันค้นหา Object ใน Workspace
local function FindObject(parent, name)
    if not parent then return nil end
    for _, v in pairs(parent:GetDescendants()) do
        if v.Name == name then
            if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") then
                return v.HumanoidRootPart
            elseif v:IsA("BasePart") then
                return v
            end
        end
    end
    return nil
end

MainTab:CreateToggle({
   Name = "ออโต้ฟาร์มเลเวล",
   CurrentValue = false,
   Flag = "AutoFarmLevelMaster",
   Callback = function(Value)
      masterFarmLevelEnabled = Value
      
      -- จัดการตั้งค่าเริ่มต้นของอมตะทันทีเมื่อกดเปิด
      local char = LocalPlayer.Character
      if char and char:FindFirstChild("Humanoid") then
          local hum = char.Humanoid
          if Value then
              hum.MaxHealth = math.huge
              hum.Health = math.huge
              hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
          else
              hum.MaxHealth = 100
              hum.Health = 100
              hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
          end
      end

      Rayfield:Notify({
         Title = "สถานะออโต้ฟาร์มเลเวล",
         Content = Value and "เปิดใช้งานออโต้ฟาร์มเลเวล (รับเควส + อมตะ + ตีออโต้) แล้ว" or "ปิดการทำงานทั้งหมดแล้ว",
         Duration = 2,
      })
   end,
})

-- ฟังก์ชันดูแลอมตะต่อเนื่อง (ป้องกันเลือดลดและป้องกันตาย)
local function SetupGodMode(char)
    local hum = char:WaitForChild("Humanoid")
    hum.MaxHealth = math.huge
    hum.Health = math.huge
    hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)

    hum.HealthChanged:Connect(function()
        if masterFarmLevelEnabled then
            if hum.Health < hum.MaxHealth then
                hum.Health = hum.MaxHealth
            end
        end
    end)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if masterFarmLevelEnabled then
        SetupGodMode(char)
    end
end)

-- ลูปหลักทำงานทุกฟังก์ชันพร้อมกัน (อมตะ, ล็อคช่องไอเท็ม, ขยาย Hitbox, รับเควส และบินไปตีมอนสเตอร์)
task.spawn(function()
    while task.wait(0.03) do
        if masterFarmLevelEnabled then
            pcall(function()
                local char = LocalPlayer.Character
                local backpack = LocalPlayer:FindFirstChild("Backpack")
                
                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                    local hrp = char.HumanoidRootPart
                    local humanoid = char.Humanoid

                    -- 1. ล็อคเลือดให้อมตะตลอดเวลา
                    if humanoid.Health < humanoid.MaxHealth then
                        humanoid.Health = humanoid.MaxHealth
                    end

                    -- 2. ปิดการชนเพื่อไม่ให้ติดสิ่งกีดขวาง
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end

                    -- 3. บังคับถือเฉพาะไอเท็มช่องที่ 1 ตลอดเวลา
                    if backpack then
                        local slot1Item = nil
                        for _, item in ipairs(backpack:GetChildren()) do
                            if item:IsA("Tool") then
                                slot1Item = item
                                break
                            end
                        end
                        local currentTool = char:FindFirstChildOfClass("Tool")
                        if slot1Item and currentTool ~= slot1Item then
                            humanoid:EquipTool(slot1Item)
                        end
                    end

                    -- 4. เคลียร์ค่า Debounce และขยาย Hitbox ตีรอบทิศทาง
                    local dog = char:FindFirstChild("Hisense170's Dog")
                    if dog then
                        local debounceFolder = dog:FindFirstChild("Attacks_Debounce")
                        if debounceFolder then
                            for _, v in pairs(debounceFolder:GetChildren()) do
                                if v:IsA("NumberValue") or v:IsA("IntValue") then
                                    v.Value = 0
                                elseif v:IsA("BoolValue") then
                                    v.Value = false
                                end
                            end
                        end
                    end

                    for _, tool in pairs(char:GetChildren()) do
                        if tool:IsA("Tool") then
                            for _, part in pairs(tool:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    part.Size = Vector3.new(35, 35, 35)
                                    part.Transparency = 0.9
                                    part.CanCollide = false
                                end
                            end
                        end
                    end

                    -- 5. ตรวจสอบเลเวลและจัดการรับเควสตามช่วงเลเวล
                    local playerLevel = 1
                    if LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Level") then
                        playerLevel = LocalPlayer.Data.Level.Value
                    end

                    local questName = "Floppa Quest 1"
                    local monsterName = "Floppa"

                    if playerLevel >= 15 and playerLevel < 30 then
                        questName = "Floppa Quest 2"
                        monsterName = "Floppa"
                    elseif playerLevel >= 30 then
                        questName = "Floppa Quest 3"
                        monsterName = "Floppa"
                    end

                    -- เช็คว่ามีเควสอยู่หรือไม่ (ถ้ายังไม่มีหรือต้องรับ ให้บินไปรับ)
                    local questPart = FindObject(Workspace, questName) or FindObject(Workspace, "Main Quest")
                    if questPart then
                        FlyTo(questPart.CFrame + Vector3.new(0, 3, 0))
                        task.wait(0.5)
                        for _, v in pairs(Workspace:GetDescendants()) do
                            if v:IsA("ProximityPrompt") and (v.Parent.Position - hrp.Position).Magnitude < 15 then
                                fireproximityprompt(v)
                            end
                        end
                    end

                    -- 6. ค้นหามอนสเตอร์และบินไปจัดการตีจนกว่าจะตายวนไปเรื่อยๆ
                    local monsterPart = FindObject(Workspace, monsterName)
                    if monsterPart then
                        local behindMonsterCFrame = monsterPart.CFrame * CFrame.new(0, 3, 4)
                        FlyTo(behindMonsterCFrame)

                        while masterFarmLevelEnabled and monsterPart and monsterPart.Parent and monsterPart.Parent:FindFirstChild("Humanoid") and monsterPart.Parent.Humanoid.Health > 0 do
                            hrp.CFrame = monsterPart.CFrame * CFrame.new(0, 3, 4)
                            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

                            local tool = char:FindFirstChildOfClass("Tool")
                            if tool then
                                tool:Activate()
                            end
                            task.wait(0.2)
                        end
                    end
                end
            end)
        end
    end
end)

