-- ==================== ระบบเบื้องหลังออโต้ฟาร์ม ====================
local masterFarmLevelEnabled = false

local function FlyTo(targetCFrame)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = LocalPlayer.Character.HumanoidRootPart
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    if distance < 5 then return end
    local speed = 350
    local timeTake = distance / speed
    
    local tweenInfo = TweenInfo.new(timeTake, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    
    local completed = false
    local connection
    connection = tween.Completed:Connect(function()
        completed = true
        connection:Disconnect()
    end)
    
    while not completed and masterFarmLevelEnabled do
        task.wait()
    end
    if not masterFarmLevelEnabled then
        tween:Cancel()
    end
end

local function FindObject(parent, name)
    if not parent then return nil end
    for _, v in pairs(parent:GetDescendants()) do
        if v.Name == name then
            if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") then
                return v.HumanoidRootPart
            elseif v:IsA("BasePart") then
                return v
            end
        end
    end
    return nil
end

local function FindNearestMonster(monsterName)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = char.HumanoidRootPart
    
    local nearest = nil
    local shortestDistance = math.huge
    
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("Model") and v.Name == monsterName then
            local hum = v:FindFirstChildOfClass("Humanoid")
            local root = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Head")
            if hum and root and hum.Health > 0 then
                local dist = (hrp.Position - root.Position).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    nearest = root
                end
            end
        end
    end
    return nearest
end

local function SetupGodMode(char)
    local hum = char:WaitForChild("Humanoid")
    hum.MaxHealth = math.huge
    hum.Health = math.huge
    hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)

    hum.HealthChanged:Connect(function()
        if masterFarmLevelEnabled then
            if hum.Health < hum.MaxHealth then
                hum.Health = hum.MaxHealth
            end
        end
    end)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if masterFarmLevelEnabled then
        SetupGodMode(char)
    end
end)

FarmToggleBtn.MouseButton1Click:Connect(function()
    masterFarmLevelEnabled = not masterFarmLevelEnabled
    
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        local hum = char.Humanoid
        if masterFarmLevelEnabled then
            hum.MaxHealth = math.huge
            hum.Health = math.huge
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            SetupGodMode(char)
            
            FarmToggleBtn.Text = "ON"
            FarmToggleBtn.TextColor3 = Color3.fromRGB(0, 162, 255)
            FarmToggleStroke.Color = Color3.fromRGB(0, 162, 255)
        else
            hum.MaxHealth = 100
            hum.Health = 100
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
            
            FarmToggleBtn.Text = "OFF"
            FarmToggleBtn.TextColor3 = Color3.fromRGB(220, 60, 60)
            FarmToggleStroke.Color = Color3.fromRGB(220, 60, 60)
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.2)
        if masterFarmLevelEnabled then
            pcall(function()
                local playerLevel = 1
                if LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Level") then
                    playerLevel = LocalPlayer.Data.Level.Value
                end

                local questName = "Floppa Quest 1"
                local monsterName = "Floppa"

                if playerLevel >= 15 and playerLevel < 30 then
                    questName = "Floppa Quest 2"
                    monsterName = "Floppa"
                elseif playerLevel >= 30 then
                    questName = "Floppa Quest 3"
                    monsterName = "Floppa"
                end

                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") or char.Humanoid.Health <= 0 then return end
                local hrp = char.HumanoidRootPart
                local humanoid = char.Humanoid

                if humanoid.Health < humanoid.MaxHealth then
                    humanoid.Health = humanoid.MaxHealth
                end
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end

                local backpack = LocalPlayer:FindFirstChild("Backpack")
                if backpack then
                    local slot1Item = nil
                    for _, item in ipairs(backpack:GetChildren()) do
                        if item:IsA("Tool") then
                            slot1Item = item
                            break
                        end
                    end
                    local currentTool = char:FindFirstChildOfClass("Tool")
                    if slot1Item and currentTool ~= slot1Item then
                        humanoid:EquipTool(slot1Item)
                    end
                end

                local questPart = FindObject(Workspace, questName) or FindObject(Workspace, "Main Quest")
                if questPart then
                    if (hrp.Position - questPart.Position).Magnitude > 25 then
                        FlyTo(questPart.CFrame + Vector3.new(0, 3, 0))
                        task.wait(0.3)
                    end
                    for _, v in pairs(Workspace:GetDescendants()) do
                        if v:IsA("ProximityPrompt") and (v.Parent.Position - hrp.Position).Magnitude < 25 then
                            fireproximityprompt(v)
                        end
                    end
                end

                local monsterPart = FindNearestMonster(monsterName)
                if monsterPart then
                    FlyTo(monsterPart.CFrame * CFrame.new(0, 3, 4))

                    while masterFarmLevelEnabled and monsterPart and monsterPart.Parent and monsterPart.Parent:FindFirstChild("Humanoid") and monsterPart.Parent.Humanoid.Health > 0 do
                        hrp.CFrame = monsterPart.CFrame * CFrame.new(0, 3, 4)
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

                        local tool = char:FindFirstChildOfClass("Tool")
                        if tool then
                            tool:Activate()
                        end
                        task.wait(0.15)
                    end
                end
            end)
        end
    end
end)

