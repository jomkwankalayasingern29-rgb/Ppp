-- ==================== ลำดับการทำงาน (Loading & Animation) ====================
task.spawn(function()
    -- 1. กำลังโหลด... 2 วินาที
    local dots = {"", ".", "..", "..."}
    local startTime = tick()
    
    while tick() - startTime < 2 do
        for _, d in ipairs(dots) do
            LoadText.Text = "กำลังโหลด" .. d
            task.wait(0.3)
        end
    end
    
    -- 2. ดาวโหลดเสร็จเเล้ว 1 วินาที
    LoadText.Text = "ดาวโหลดเสร็จเเล้ว"
    task.wait(1)
    
    -- 3. คัดลอกลิ้งดิสเสร็จเเล้ว + คัดลอกอัตโนมัติ
    LoadText.Text = "คัดลอกลิ้งดิสเสร็จเเล้ว"
    if setclipboard then
        setclipboard("https://discord.gg/Ugssja4wqQ")
    end
    task.wait(1)
    
    -- 4. ลบหน้าจอโหลดทิ้ง
    LoadFrame:Destroy()
    
    -- 5. ค่อยๆ ขยายหน้าต่าง UI หลักขึ้นมาแบบช้าๆ
    MainFrame.Visible = true
    MainFrame.Size = UDim2.new(0, 320, 0, 180)
    
    local TweenService = game:GetService("TweenService")
    local info = TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    
    local expandTween = TweenService:Create(MainFrame, info, {
        Size = UDim2.new(0, 380, 0, 210),
        BackgroundTransparency = 0
    })
    
    expandTween:Play()
end)
