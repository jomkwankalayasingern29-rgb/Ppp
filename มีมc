-- ลูปการทำงานฟาร์ม 1-25
task.spawn(function()
    while true do
        task.wait(0.2)
        if masterFarmLevelEnabled then
            pcall(function()
                local questName = "Floppa Quest 1"
                local monsterName = "Floppa"

                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") or char.Humanoid.Health <= 0 then return end
                local hrp = char.HumanoidRootPart
                local humanoid = char.Humanoid

                if humanoid.Health < humanoid.MaxHealth then
                    humanoid.Health = humanoid.MaxHealth
                end
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end

                local backpack = LocalPlayer:FindFirstChild("Backpack")
                if backpack then
                    local slot1Item = nil
                    for _, item in ipairs(backpack:GetChildren()) do
                        if item:IsA("Tool") then
                            slot1Item = item
                            break
                        end
                    end
                    local currentTool = char:FindFirstChildOfClass("Tool")
                    if slot1Item and currentTool ~= slot1Item then
                        humanoid:EquipTool(slot1Item)
                    end
                end

                local questPart = FindObject(Workspace, questName) or FindObject(Workspace, "Main Quest")
                if questPart then
                    if (hrp.Position - questPart.Position).Magnitude > 25 then
                        FlyTo(questPart.CFrame + Vector3.new(0, 3, 0), function() return masterFarmLevelEnabled end)
                        task.wait(0.3)
                    end
                    for _, v in pairs(Workspace:GetDescendants()) do
                        if v:IsA("ProximityPrompt") and (v.Parent.Position - hrp.Position).Magnitude < 25 then
                            fireproximityprompt(v)
                        end
                    end
                end

                local monsterPart = FindNearestMonster(monsterName)
                if monsterPart then
                    FlyTo(monsterPart.CFrame * CFrame.new(0, 3, 4), function() return masterFarmLevelEnabled end)

                    while masterFarmLevelEnabled and monsterPart and monsterPart.Parent and monsterPart.Parent:FindFirstChild("Humanoid") and monsterPart.Parent.Humanoid.Health > 0 do
                        local curChar = LocalPlayer.Character
                        if not curChar or not curChar:FindFirstChild("HumanoidRootPart") then break end
                        
                        curChar.HumanoidRootPart.CFrame = monsterPart.CFrame * CFrame.new(0, 3, 4)
                        curChar.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        curChar.HumanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

                        local tool = curChar:FindFirstChildOfClass("Tool")
                        if tool then
                            tool:Activate()
                        end
                        task.wait(0.15)
                    end
                end
            end)
        end
    end
end)

