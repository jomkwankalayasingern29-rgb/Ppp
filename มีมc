local masterFarmLevelEnabled = false

-- ฟังก์ชันบินไปยังเป้าหมาย (Tween)
local function FlyTo(targetCFrame)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = LocalPlayer.Character.HumanoidRootPart
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    if distance < 5 then return end -- ถ้าใกล้แล้วไม่ต้อง tween ซ้ำ
    local speed = 350
    local timeTake = distance / speed
    
    local tweenInfo = TweenInfo.new(timeTake, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    
    local completed = false
    local connection
    connection = tween.Completed:Connect(function()
        completed = true
        connection:Disconnect()
    end)
    
    while not completed and masterFarmLevelEnabled do
        task.wait()
    end
    if not masterFarmLevelEnabled then
        tween:Cancel()
    end
end

-- ฟังก์ชันค้นหา Object ใน Workspace
local function FindObject(parent, name)
    if not parent then return nil end
    for _, v in pairs(parent:GetDescendants()) do
        if v.Name == name then
            if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") then
                return v.HumanoidRootPart
            elseif v:IsA("BasePart") then
                return v
            end
        end
    end
    return nil
end

-- ฟังก์ชันค้นหามอนสเตอร์แบบเจาะจง Model ที่มี Humanoid และยังมีชีวิตอยู่
local function FindNearestMonster(monsterName)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = char.HumanoidRootPart
    
    local nearest = nil
    local shortestDistance = math.huge
    
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("Model") and v.Name == monsterName then
            local hum = v:FindFirstChildOfClass("Humanoid")
            local root = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Head")
            if hum and root and hum.Health > 0 then
                local dist = (hrp.Position - root.Position).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    nearest = root
                end
            end
        end
    end
    return nearest
end

-- UI Toggle: ออโต้ฟาร์มเลเวล
MainTab:CreateToggle({
   Name = "ออโต้ฟาร์มเลเวล (รับเควสต์ + ตีมอน)",
   CurrentValue = false,
   Flag = "AutoFarmLevelMaster",
   Callback = function(Value)
      masterFarmLevelEnabled = Value
      
      local char = LocalPlayer.Character
      if char and char:FindFirstChild("Humanoid") then
          local hum = char.Humanoid
          if Value then
              hum.MaxHealth = math.huge
              hum.Health = math.huge
              hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
          else
              hum.MaxHealth = 100
              hum.Health = 100
              hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
          end
      end

      Rayfield:Notify({
         Title = "สถานะออโต้ฟาร์มเลเวล",
         Content = Value and "เปิดใช้งานระบบออโต้ฟาร์ม (รับเควสต์+ตี+อมตะ) แล้ว" or "ปิดการทำงานทั้งหมดแล้ว",
         Duration = 2,
      })
   end,
})

-- ฟังก์ชันดูแลอมตะต่อเนื่อง
local function SetupGodMode(char)
    local hum = char:WaitForChild("Humanoid")
    hum.MaxHealth = math.huge
    hum.Health = math.huge
    hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)

    hum.HealthChanged:Connect(function()
        if masterFarmLevelEnabled then
            if hum.Health < hum.MaxHealth then
                hum.Health = hum.MaxHealth
            end
        end
    end)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if masterFarmLevelEnabled then
        SetupGodMode(char)
    end
end)

-- ลูปหลักออโต้ฟาร์ม (แก้ปัญหาตีมอนไม่ติด)
task.spawn(function()
    while task.wait(0.3) do
        if masterFarmLevelEnabled then
            pcall(function()
                local playerLevel = 1
                if LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Level") then
                    playerLevel = LocalPlayer.Data.Level.Value
                end

                local questName = "Floppa Quest 1"
                local monsterName = "Floppa"

                if playerLevel >= 15 and playerLevel < 30 then
                    questName = "Floppa Quest 2"
                    monsterName = "Floppa"
                elseif playerLevel >= 30 then
                    questName = "Floppa Quest 3"
                    monsterName = "Floppa"
                end

                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") or char.Humanoid.Health <= 0 then return end
                local hrp = char.HumanoidRootPart
                local humanoid = char.Humanoid

                -- รักษาสถานะอมตะ & ปิดการชน
                if humanoid.Health < humanoid.MaxHealth then
                    humanoid.Health = humanoid.MaxHealth
                end
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end

                -- บังคับถือไอเท็มช่องที่ 1 (Tool)
                local backpack = LocalPlayer:FindFirstChild("Backpack")
                if backpack then
                    local slot1Item = nil
                    for _, item in ipairs(backpack:GetChildren()) do
                        if item:IsA("Tool") then
                            slot1Item = item
                            break
                        end
                    end
                    local currentTool = char:FindFirstChildOfClass("Tool")
                    if slot1Item and currentTool ~= slot1Item then
                        humanoid:EquipTool(slot1Item)
                    end
                end

                -- 1. บินไปรับเควสต์ (เช็ค Prompt)
                local questPart = FindObject(Workspace, questName) or FindObject(Workspace, "Main Quest")
                if questPart then
                    -- เช็คว่าตัวละครอยู่ไกลจุดรับเควสต์ค่อยบินไป
                    if (hrp.Position - questPart.Position).Magnitude > 20 then
                        FlyTo(questPart.CFrame + Vector3.new(0, 3, 0))
                        task.wait(0.3)
                    end
                    for _, v in pairs(Workspace:GetDescendants()) do
                        if v:IsA("ProximityPrompt") and (v.Parent.Position - hrp.Position).Magnitude < 20 then
                            fireproximityprompt(v)
                        end
                    end
                end

                -- 2. ค้นหามอนสเตอร์และทำฟาร์มโจมตีต่อเนื่อง
                local monsterPart = FindNearestMonster(monsterName)
                if monsterPart then
                    FlyTo(monsterPart.CFrame * CFrame.new(0, 3, 4))

                    while masterFarmLevelEnabled and monsterPart and monsterPart.Parent and monsterPart.Parent:FindFirstChild("Humanoid") and monsterPart.Parent.Humanoid.Health > 0 do
                        -- ล็อคตัวลอยเหนือหัว/ด้านหลังมอนสเตอร์
                        hrp.CFrame = monsterPart.CFrame * CFrame.new(0, 3, 4)
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

                        -- สั่งใช้งาน Tool โจมตี
                        local tool = char:FindFirstChildOfClass("Tool")
                        if tool then
                            tool:Activate()
                        end
                        task.wait(0.15)
                    end
                end
            end)
        end
    end
end)

