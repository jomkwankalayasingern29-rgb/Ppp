    table.insert(allTextLabels, InputBox)

    local InputCorner = Instance.new("UICorner")
    InputCorner.CornerRadius = UDim.new(0, 3)
    InputCorner.Parent = InputBox

    local Back = Instance.new("Frame")
    Back.Size = UDim2.new(1, -16, 0, 4)
    Back.Position = UDim2.new(0, 8, 0, 34)
    Back.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    Back.BorderSizePixel = 0
    Back.Parent = Frame
    table.insert(allSliders, Back)

    local BackCorner = Instance.new("UICorner")
    BackCorner.CornerRadius = UDim.new(1, 0)
    BackCorner.Parent = Back

    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0, 12, 0, 12)
    Btn.Position = UDim2.new(0, 0, 0, -4)
    Btn.BackgroundColor3 = Color3.fromRGB(0, 162, 255)
    Btn.Text = ""
    Btn.Parent = Back
    table.insert(allSliders, Btn)

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(1, 0)
    BtnCorner.Parent = Btn

    local function applyValue(val, updateInput)
        val = math.clamp(val, minVal, maxVal)
        if updateInput then
            InputBox.Text = tostring(val)
        end
        local percentage = (val - minVal) / (maxVal - minVal)
        Btn.Position = UDim2.new(percentage, -6, 0, -4)
        if callback then callback(val) end
    end

    InputBox.FocusLost:Connect(function()
        local num = tonumber(InputBox.Text)
        if num then
            applyValue(math.floor(num), true)
        else
            applyValue(defaultVal, true)
        end
    end)

    return Back, Btn, InputBox, applyValue
end

