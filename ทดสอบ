local function executeCodeString(codeStr, times)
    if not codeStr or codeStr == "" then
        showNotification("ไม่มีโค้ดให้รัน!", false)
        return
    end
    local successLoad, func = pcall(function()
        return loadstring(codeStr)
    end)
    if not successLoad or not func then
        showNotification("โค้ดมีข้อผิดพลาดทางไวยากรณ์!", false)
        return
    end
    local successCount = 0
    for i = 1, times do
        local success = pcall(func)
        if success then successCount = successCount + 1 end
    end
    showNotification("รันโค้ดสำเร็จ " .. successCount .. " / " .. times .. " ครั้ง!", true)
end

