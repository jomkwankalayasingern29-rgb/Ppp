local SelectiveFpsEnabled = false
local optimizedParts = {}

local function optimizeLaggyObjects()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(Players) then
            local nameLower = string.lower(obj.Name)
            if string.find(nameLower, "debris") or string.find(nameLower, "rock") or string.find(nameLower, "stone") or string.find(nameLower, "grass") or string.find(nameLower, "leaf") or string.find(nameLower, "particle") then
                if not optimizedParts[obj] then
                    optimizedParts[obj] = {
                        CanCollide = obj.CanCollide,
                        Transparency = obj.Transparency,
                        CastShadow = obj.CastShadow,
                        Material = obj.Material
                    }
                end
                pcall(function()
                    obj.CanCollide = false
                    obj.CastShadow = false
                    obj.Transparency = 1
                    obj.Material = Enum.Material.SmoothPlastic
                end)
            end
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Explosion") then
            pcall(function()
                obj.Enabled = false
            end)
        end
    end
end

local function restoreLaggyObjects()
    for obj, data in pairs(optimizedParts) do
        if obj and obj.Parent then
            pcall(function()
                obj.CanCollide = data.CanCollide
                obj.Transparency = data.Transparency
                obj.CastShadow = data.CastShadow
                obj.Material = data.Material
            end)
        end
    end
    optimizedParts = {}
end

