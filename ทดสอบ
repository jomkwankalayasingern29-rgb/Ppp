    InputBox.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    InputBox.BorderSizePixel = 0
    InputBox.Text = tostring(defaultVal)
    InputBox.TextColor3 = Color3.fromRGB(0, 162, 255)
