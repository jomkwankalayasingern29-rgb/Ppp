local Active2D = {}
local function removeDrawingObject(model)
    if Active2D[model] then
        if Active2D[model].Box then pcall(function() Active2D[model].Box:Remove() end) end
        if Active2D[model].Tracer then pcall(function() Active2D[model].Tracer:Remove() end) end
        Active2D[model] = nil
    end
end
local function clearAllDrawings() for model, _ in pairs(Active2D) do removeDrawingObject(model) end end

local frameCounter = 0
RunService.RenderStepped:Connect(function()
    if not Drawing then return end
    if not ScreenGui.Parent or not LockConfig.MasterEsp2D then 
        if next(Active2D) then clearAllDrawings() end
        return 
    end

    frameCounter = frameCounter + 1
    if frameCounter % 2 ~= 0 then return end

    for model, _ in pairs(Active2D) do
        if not model or not model.Parent or not model:FindFirstChild("Humanoid") or model.Humanoid.Health <= 0 then 
            removeDrawingObject(model) 
        end
    end

    local function drawESP(model, isNpc)
        local isEnabled = isNpc and LockConfig.NpcEsp2D or (not isNpc and LockConfig.PlayerEsp2D)
        if not isEnabled then 
            removeDrawingObject(model)
            return 
        end

        if not Active2D[model] and Drawing then
            local successBox, box = pcall(function() return Drawing.new("Square") end)
            local successTracer, tracer = pcall(function() return Drawing.new("Line") end)
            if successBox and successTracer then
                box.Visible = false; box.Thickness = 1.2; box.Filled = false
                tracer.Visible = false; tracer.Thickness = 1.2
                Active2D[model] = {Box = box, Tracer = tracer}
            end
        end
        
        local hrp = model:FindFirstChild("HumanoidRootPart")
        local head = model:FindFirstChild("Head") or model:FindFirstChild("UpperTorso")
        local data = Active2D[model]
        
        if hrp and head and data and data.Box and data.Tracer then
            local hrpPos, hrpOnScreen = Camera:WorldToViewportPoint(hrp.Position)
            local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.8, 0))
            local legPos, legOnScreen = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
            
            if hrpOnScreen or headOnScreen or legOnScreen then
                local visible = isVisible(hrp, model)
                local col = visible and (isNpc and Color3.fromRGB(0, 162, 255) or Color3.fromRGB(0, 255, 100)) or (isNpc and Color3.fromRGB(0, 80, 200) or Color3.fromRGB(220, 60, 60))
                
                data.Box.Color = col
                data.Tracer.Color = col
                
                local height = math.abs(headPos.Y - legPos.Y)
                local width = height * 0.55
                
                data.Box.Size = Vector2.new(width, height)
                data.Box.Position = Vector2.new(hrpPos.X - width / 2, headPos.Y)
                data.Box.Visible = true
                
                data.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                data.Tracer.To = Vector2.new(hrpPos.X, legPos.Y)
                data.Tracer.Visible = true
            else
                data.Box.Visible = false
                data.Tracer.Visible = false
            end
        elseif data and data.Box and data.Tracer then
            data.Box.Visible = false
            data.Tracer.Visible = false
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then 
            drawESP(player.Character, false) 
        end
    end
    
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc:IsA("Model") and desc:FindFirstChild("Humanoid") and desc.Humanoid.Health > 0 and not Players:GetPlayerFromCharacter(desc) and desc ~= LocalPlayer.Character then 
            if desc:FindFirstChild("HumanoidRootPart") then
                drawESP(desc, true) 
            end
        end
    end
end)

local function getClosestTarget()
    local closestPart, shortestDist = nil, math.huge
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return nil end
    local myRootPos = LocalPlayer.Character.HumanoidRootPart.Position

    if LockConfig.FullLock then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                local head = p.Character.Head
                if not LockConfig.FullLockTorsoWallCheck or isVisible(head, p.Character) then
                    local dist = (head.Position - myRootPos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestPart = head
                    end
                end
            end
        end
        return closestPart
    end

    if LockConfig.FullLockTorso then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                local torso = p.Character.HumanoidRootPart
                if not LockConfig.FullLockTorsoWallCheck or isVisible(torso, p.Character) then
                    local dist = (torso.Position - myRootPos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestPart = torso
                    end
                end
            end
        end
        return closestPart
    end

    local function processModel(model, isNpc)
        local pName = (isNpc and (LockConfig.NPCHead and "Head" or LockConfig.NPCTorso and "HumanoidRootPart")) or (LockConfig.PlayerHead and "Head" or LockConfig.PlayerTorso and "HumanoidRootPart")
        if not pName then return end
        local part = model:FindFirstChild(pName) or (pName == "HumanoidRootPart" and (model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")))
        if part and model:FindFirstChild("Humanoid") and model.Humanoid.Health > 0 then
            local partPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local dist = (Vector2.new(partPos.X, partPos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                if dist <= FOV_Radius and dist < shortestDist and (not WallCheckEnabled or isVisible(part, model)) then
                    shortestDist = dist; closestPart = part
                end
            end
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer and p.Character then processModel(p.Character, false) end end
    for _, d in ipairs(Workspace:GetDescendants()) do if d:IsA("Model") and d:FindFirstChild("Humanoid") and not Players:GetPlayerFromCharacter(d) and d ~= LocalPlayer.Character then processModel(d, true) end end
    return closestPart
end

RunService.RenderStepped:Connect(function()
    if not ScreenGui.Parent then return end
    local anyLockEnabled = LockConfig.PlayerHead or LockConfig.PlayerTorso or LockConfig.NPCHead or LockConfig.NPCTorso or LockConfig.FullLock or LockConfig.FullLockTorso
    if not anyLockEnabled then return end
    
    local targetPart = getClosestTarget()
    if targetPart then 
        if LockConfig.FullLock or LockConfig.FullLockTorso then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
        else
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetPart.Position), math.clamp(LockSpeed / 100, 0.02, 1)) 
        end
    end
end)

