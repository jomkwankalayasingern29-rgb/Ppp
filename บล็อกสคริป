local function GetTargetPart(targetType)
    local targetPart = nil
    local shortestDistance = getgenv().CircleRadius
    local screenSize = Camera.ViewportSize
    local centerScreen = Vector2.new(screenSize.X / 2, screenSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local character = player.Character
            local part = character:FindFirstChild(targetType == "Head" and "Head" or "HumanoidRootPart")
            
            if part then
                local screenPoint, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local screenPos2D = Vector2.new(screenPoint.X, screenPoint.Y)
                    local distance = (screenPos2D - centerScreen).Magnitude
                    
                    if distance < shortestDistance then
                        shortestDistance = distance
                        targetPart = part
                    end
                end
            end
        end
    end
    return targetPart
end

-- 1. ระบบกระสุนเลี้ยว (Silent Aim Hook)
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    
    if getgenv().SilentAimEnabled and (method == "FireServer" or method == "InvokeServer") then
        local target = GetTargetPart(getgenv().SilentAimTarget)
        if target then
            for i, v in ipairs(args) do
                if typeof(v) == "Vector3" then
                    args[i] = target.Position
                elseif typeof(v) == "CFrame" then
                    args[i] = CFrame.new(v.Position, target.Position)
                elseif typeof(v) == "Instance" and v:IsA("BasePart") then
                    if v.Name == "HumanoidRootPart" or v.Name == "Torso" or v.Name:lower():find("part") then
                        args[i] = target
                    end
                end
            end
        end
    end
    
    return oldNamecall(self, unpack(args))
end)

-- 2. ระบบจอล็อก (Cam Lock)
RunService.RenderStepped:Connect(function()
    if getgenv().CamLockEnabled then
        local target = GetTargetPart(getgenv().CamLockTarget)
        if target then
            local targetCFrame = CFrame.new(Camera.CFrame.Position, target.Position)
            local speedAlpha = getgenv().CamLockSpeedPercent / 100
            
            if speedAlpha >= 1 then
                Camera.CFrame = targetCFrame
            else
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, speedAlpha)
            end
        end
    end
end)

-- 3. ระบบฟังก์ชันอมตะ (Max Health, God Mode, Auto Heal)
task.spawn(function()
    while true do
        local char = LocalPlayer.Character
        if char then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid then
                -- แบบที่ 1: เพิ่มเลือด 999,999,999
                if getgenv().MaxHealthEnabled then
                    if humanoid.MaxHealth ~= 999999999 then
                        humanoid.MaxHealth = 999999999
                        humanoid.Health = 999999999
                    end
                end

                -- แบบที่ 2: บังคับไม่ให้เลือดลด (God Mode)
                if getgenv().GodModeEnabled then
                    if humanoid.Health < humanoid.MaxHealth then
                        humanoid.Health = humanoid.MaxHealth
                    end
                end

                -- แบบที่ 3: เด้งเลือดรัวๆ ความเร็ว 0.1 วินาที ให้เต็มหลอด
                if getgenv().AutoHealEnabled then
                    humanoid.Health = humanoid.MaxHealth
                end
            end
        end
        task.wait(getgenv().AutoHealEnabled and 0.1 or 0.5)
    end
end)

-- 4. ระบบ ESP (3D & 2D พร้อม Tracer เส้นเชื่อมไปหาเป้าหมาย)
RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            local humanoid = character and character:FindFirstChild("Humanoid")
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            
            if character and humanoid and rootPart and humanoid.Health > 0 then
                if not ESPObjects[player] then
                    -- สร้าง Drawing สำหรับ ESP 3D
                    local box3D = {}
                    for i = 1, 12 do
                        local line = Drawing.new("Line")
                        line.Visible = false
                        line.Thickness = 1.5
                        line.Color = Color3.fromRGB(0, 255, 128)
                        table.insert(box3D, line)
                    end

                    -- สร้าง Drawing สำหรับ ESP 2D
                    local box2D = {}
                    for i = 1, 4 do
                        local line = Drawing.new("Line")
                        line.Visible = false
                        line.Thickness = 1.5
                        line.Color = Color3.fromRGB(255, 255, 255)
                        table.insert(box2D, line)
                    end

                    -- เส้น Tracer เชื่อมจากล่างจอไปหาตัวละคร
                    local tracer = Drawing.new("Line")
                    tracer.Visible = false
                    tracer.Thickness = 1
                    tracer.Color = Color3.fromRGB(255, 255, 255)
                    tracer.Transparency = 0.7

                    -- ชื่อผู้เล่นด้านบน
                    local nameTag = Drawing.new("Text")
                    nameTag.Visible = false
                    nameTag.Center = true
                    nameTag.Outline = true
                    nameTag.Size = 13
                    nameTag.Color = Color3.fromRGB(255, 255, 255)

                    ESPObjects[player] = {Box3D = box3D, Box2D = box2D, Tracer = tracer, NameTag = nameTag}
                end

                local data = ESPObjects[player]

                -- จัดการ ESP 3D
                if getgenv().ESP3DEnabled then
                    local cf = rootPart.CFrame
                    local size = Vector3.new(2, 3, 1)
                    local corners = {
                        cf * CFrame.new(-size.X, size.Y, -size.Z),
                        cf * CFrame.new(size.X, size.Y, -size.Z),
                        cf * CFrame.new(size.X, size.Y, size.Z),
                        cf * CFrame.new(-size.X, size.Y, size.Z),
                        cf * CFrame.new(-size.X, -size.Y, -size.Z),
                        cf * CFrame.new(size.X, -size.Y, -size.Z),
                        cf * CFrame.new(size.X, -size.Y, size.Z),
                        cf * CFrame.new(-size.X, -size.Y, size.Z),
                    }
                    local screenCorners = {}
                    local allOnScreen = true
                    for i, corner in ipairs(corners) do
                        local pos, onScreen = Camera:WorldToViewportPoint(corner.Position)
                        screenCorners[i] = Vector2.new(pos.X, pos.Y)
                        if not onScreen then allOnScreen = false end
                    end

                    local connections = {
                        {1,2}, {2,3}, {3,4}, {4,1},
                        {5,6}, {6,7}, {7,8}, {8,5},
                        {1,5}, {2,6}, {3,7}, {4,8}
                    }

                    for i, conn in ipairs(connections) do
                        local line = data.Box3D[i]
                        if allOnScreen then
                            line.From = screenCorners[conn[1]]
                            line.To = screenCorners[conn[2]]
                            line.Visible = true
                        else
                            line.Visible = false
                        end
                    end
                else
                    for _, line in ipairs(data.Box3D) do line.Visible = false end
                end

                -- จัดการ ESP 2D, Tracer & NameTag
                if getgenv().ESP2DEnabled then
                    local head = character:FindFirstChild("Head")
                    if head then
                        local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                        local legPos, legOnScreen = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
                        
                        if headOnScreen or legOnScreen then
                            local height = math.abs(headPos.Y - legPos.Y)
                            local width = height / 2
                            local x = headPos.X - (width / 2)
                            local y = headPos.Y

                            -- 4 เส้นขอบ Bounding Box 2D
                            data.Box2D[1].From = Vector2.new(x, y)
                            data.Box2D[2].From = Vector2.new(x + width, y)
                            data.Box2D[3].From = Vector2.new(x, y + height)
                            data.Box2D[4].From = Vector2.new(x, y + height)

                            data.Box2D[1].To = Vector2.new(x + width, y)
                            data.Box2D[2].To = Vector2.new(x + width, y + height)
                            data.Box2D[3].To = Vector2.new(x + width, y + height)
                            data.Box2D[4].To = Vector2.new(x, y)

                            for _, line in ipairs(data.Box2D) do line.Visible = true end

                            -- เส้น Tracer เชื่อมจากล่างจอตรงกลาง ไปยังตัวละคร (ตรงกึ่งกลางล่างของกรอบ 2D)
                            local screenSize = Camera.ViewportSize
                            data.Tracer.From = Vector2.new(screenSize.X / 2, screenSize.Y)
                            data.Tracer.To = Vector2.new(x + (width / 2), y + height)
                            data.Tracer.Visible = true

                            -- ชื่อผู้เล่นเหนือจอ
                            data.NameTag.Text = player.Name
                            data.NameTag.Position = Vector2.new(headPos.X, y - 18)
                            data.NameTag.Visible = true
                        else
                            for _, line in ipairs(data.Box2D) do line.Visible = false end
                            data.Tracer.Visible = false
                            data.NameTag.Visible = false
                        end
                    end
                else
                    for _, line in ipairs(data.Box2D) do line.Visible = false end
                    data.Tracer.Visible = false
                    data.NameTag.Visible = false
                end
            else
                RemoveESP(player)
            end
        end
    end
end)

