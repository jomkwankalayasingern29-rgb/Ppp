-- ตารางเก็บ Drawing สำหรับ ESP
local ESPObjects = {}

local function RemoveESP(player)
    if ESPObjects[player] then
        if ESPObjects[player].Box3D then
            for _, line in pairs(ESPObjects[player].Box3D) do
                line:Remove()
            end
        end
        if ESPObjects[player].Box2D then
            for _, line in pairs(ESPObjects[player].Box2D) do
                line:Remove()
            end
        end
        if ESPObjects[player].Tracer then
            ESPObjects[player].Tracer:Remove()
        end
        if ESPObjects[player].NameTag then
            ESPObjects[player].NameTag:Remove()
        end
        ESPObjects[player] = nil
    end
end

