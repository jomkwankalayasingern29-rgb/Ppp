local function GetTargetPart(targetType)
    local targetPart = nil
    local shortestDistance = getgenv().CircleRadius
    local screenSize = Camera.ViewportSize
    local centerScreen = Vector2.new(screenSize.X / 2, screenSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local character = player.Character
            local part = character:FindFirstChild(targetType == "Head" and "Head" or "HumanoidRootPart")
            
            if part then
                local screenPoint, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local screenPos2D = Vector2.new(screenPoint.X, screenPoint.Y)
                    local distance = (screenPos2D - centerScreen).Magnitude
                    
                    if distance < shortestDistance then
                        shortestDistance = distance
                        targetPart = part
                    end
                end
            end
        end
    end
    return targetPart
end

-- ฟังก์ชันหาตัวละครที่อยู่ใกล้ที่สุด (สำหรับโหมดหันหน้า)
local function GetNearestRootPart()
    local nearestPart = nil
    local shortestDist = math.huge
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myPos = LocalPlayer.Character.HumanoidRootPart.Position
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
                local targetRoot = player.Character.HumanoidRootPart
                local dist = (myPos - targetRoot.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    nearestPart = targetRoot
                end
            end
        end
    end
    return nearestPart
end

-- 1. ระบบกระสุนเลี้ยว (Silent Aim Hook)
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    
    if getgenv().SilentAimEnabled and (method == "FireServer" or method == "InvokeServer") then
        local target = GetTargetPart(getgenv().SilentAimTarget)
        if target then
            for i, v in ipairs(args) do
                if typeof(v) == "Vector3" then
                    args[i] = target.Position
                elseif typeof(v) == "CFrame" then
                    args[i] = CFrame.new(v.Position, target.Position)
                elseif typeof(v) == "Instance" and v:IsA("BasePart") then
                    if v.Name == "HumanoidRootPart" or v.Name == "Torso" or v.Name:lower():find("part") then
                        args[i] = target
                    end
                end
            end
        end
    end
    
    return oldNamecall(self, unpack(args))
end)

-- 2. ระบบจอล็อก (Cam Lock) & ระบบหันหน้าหาศัตรู (LookAt)
RunService.RenderStepped:Connect(function()
    if getgenv().CamLockEnabled then
        local target = GetTargetPart(getgenv().CamLockTarget)
        if target then
            local targetCFrame = CFrame.new(Camera.CFrame.Position, target.Position)
            local speedAlpha = getgenv().CamLockSpeedPercent / 100
            
            if speedAlpha >= 1 then
                Camera.CFrame = targetCFrame
            else
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, speedAlpha)
            end
        end
    end

    -- ฟังก์ชันหันหน้าหาศัตรู (ตัวละครหัน แต่จอไม่หันตาม)
    if getgenv().LookAtEnabled then
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            local targetRoot = GetNearestRootPart()
            if targetRoot then
                local myRoot = myChar.HumanoidRootPart
                local lookAtPos = Vector3.new(targetRoot.Position.X, myRoot.Position.Y, targetRoot.Position.Z)
                myRoot.CFrame = CFrame.new(myRoot.Position, lookAtPos)
            end
        end
    end
end)

