-- ==================== ระบบอนิเมชั่นโหลดและเปิดหน้าต่าง ====================
task.spawn(function()
    local dots = {"", ".", "..", "..."}
    local startTime = tick()
    
    while tick() - startTime < 1.5 do
        for _, d in ipairs(dots) do
            LoadText.Text = "กำลังโหลด" .. d
            task.wait(0.25)
        end
    end
    
    LoadText.Text = "โหลดเสร็จสิ้น!"
    task.wait(0.5)
    
    TweenService:Create(LoadFrame, TweenInfo.new(0.3), {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1}):Play()
    TweenService:Create(LoadText, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
    task.wait(0.3)
    LoadFrame:Destroy()
    
    MainFrame.Visible = true
    MainFrame.Size = UDim2.new(0, 0, 0, 0)
    MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    
    local openTween = TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 440, 0, 280),
        Position = UDim2.new(0.5, -220, 0.5, -140),
        BackgroundTransparency = 0
    })
    openTween:Play()
end)
